<?xml version="1.0" encoding="utf-8"?>
<!-- Default: nuget.org only. Kyra SDK feed: tools/Validate-KyraSdkPackageFeed.ps1 → nuget.config.ci (gitignored) with KYRA_SDK_FEED_PATH or -KyraSdkFeedPath. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
