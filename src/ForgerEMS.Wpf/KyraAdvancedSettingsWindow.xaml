<Window x:Class="VentoyToolkitSetup.Wpf.KyraAdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kyra AI Settings"
        Width="1040"
        Height="780"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#FF04070D"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="KyraAdvancedPanelBackground" Color="#CC07101D" />
        <SolidColorBrush x:Key="KyraAdvancedCardBackground" Color="#B307101D" />
        <SolidColorBrush x:Key="KyraAdvancedCardBorder" Color="#4A5ED1FF" />
        <SolidColorBrush x:Key="KyraAdvancedHeaderBrush" Color="#FFFFC58F" />
        <SolidColorBrush x:Key="KyraAdvancedTextBrush" Color="#FFF4F8FF" />
        <SolidColorBrush x:Key="KyraAdvancedMutedTextBrush" Color="#FFD0DBEA" />
        <SolidColorBrush x:Key="KyraAdvancedInputBackground" Color="#EE0E1A29" />
        <SolidColorBrush x:Key="KyraAdvancedInputBorder" Color="#7B67B7E8" />

        <Style x:Key="KyraAdvancedTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource KyraAdvancedTextBrush}" />
        </Style>

        <Style x:Key="KyraAdvancedTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFE8EEF9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#660F1828" />
            <Setter Property="BorderBrush" Value="#5B4A6580" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FF0B1220" />
                    <Setter Property="Background" Value="#FFF2E6D5" />
                    <Setter Property="BorderBrush" Value="#B35EEBE4" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="False" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="Background" Value="#991A2A3D" />
                    <Setter Property="BorderBrush" Value="#8C67B7E8" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KyraAdvancedScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="KyraSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource KyraAdvancedHeaderBrush}" />
        </Style>

        <Style x:Key="KyraCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource KyraAdvancedCardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource KyraAdvancedCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#B30F1724" />
            <Setter Property="BorderBrush" Value="#8867B7E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFE8F0FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6162436" />
                    <Setter Property="BorderBrush" Value="#FFFFB86B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource KyraAdvancedTextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource KyraAdvancedInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="{StaticResource KyraAdvancedInputBackground}" />
            <Setter Property="Foreground" Value="#FFF4F8FF" />
            <Setter Property="CaretBrush" Value="#FFFFDAB8" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="{StaticResource KyraAdvancedInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="{StaticResource KyraAdvancedInputBackground}" />
            <Setter Property="Foreground" Value="#FFF4F8FF" />
            <Setter Property="CaretBrush" Value="#FFFFDAB8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{StaticResource KyraAdvancedInputBackground}" />
            <Setter Property="Foreground" Value="#FF0B1220" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource KyraAdvancedTextBrush}" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource KyraAdvancedTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="Assets/KyraAdvancedBackground.png"
               Stretch="UniformToFill"
               Opacity="0.30"
               RenderOptions.BitmapScalingMode="Fant"
               IsHitTestVisible="False" />
        <Rectangle Fill="#A604070D" IsHitTestVisible="False" />

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Image DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,10,0" Source="Assets/Kyra.png" />
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource KyraAdvancedHeaderBrush}" Text="Kyra AI Settings" />
                    <TextBlock FontSize="12" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Choose Gateway, BYOK, local AI, live tools, and privacy settings. Keys stay hidden." />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource KyraAdvancedPanelBackground}"
                    BorderBrush="#9967B7E8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <TabControl Style="{StaticResource KyraAdvancedTabControlStyle}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource KyraAdvancedTabItemStyle}" />
                    </TabControl.ItemContainerStyle>

                    <TabItem Header="Overview">
                        <ScrollViewer Style="{StaticResource KyraAdvancedScrollViewerStyle}" Padding="0,12,0,0">
                            <WrapPanel>
                                <Border Style="{StaticResource KyraCardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Kyra Mode" />
                                        <ComboBox Margin="0,10,0,6"
                                                  ItemsSource="{Binding CopilotModeOptions}"
                                                  SelectedItem="{Binding SelectedCopilotMode}" />
                                        <TextBlock FontSize="12" Text="{Binding CopilotOnlineStatusText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KyraCardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Current Provider" />
                                        <TextBlock Margin="0,10,0,0" FontSize="13" Text="{Binding CopilotProviderBadgeText}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding CopilotProviderSummaryText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KyraCardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Privacy" />
                                        <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding CopilotPrivacyBadgeText}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Keys hidden. Local scan facts are summarized before online use. Do not send secrets in support email." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KyraCardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="ForgerEMS Beta Gateway" />
                                        <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding KyraGatewayProviderStatusSummary}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Uses ForgerEMS-managed gateway token. Provider API keys stay server-side. Best for beta testers." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KyraCardStyle}" Width="620">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Live Tools" />
                                        <TextBlock Margin="0,8,0,0" FontSize="12" Text="Weather, crypto, calculator, date/time, and System Intelligence can work without general web search. Web Search shows as Gateway search available or Not configured depending on provider setup." TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0" FontSize="11.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Web Search: Ready when Gateway search is available or a BYOK search provider is configured." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KyraCardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="System Context" />
                                        <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding CopilotContextSummaryText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Providers">
                        <ScrollViewer Style="{StaticResource KyraAdvancedScrollViewerStyle}" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Provider Cards" />
                                <TextBlock Margin="0,6,0,12" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Pick a preferred provider, test setup, and keep Local Kyra as fallback. Gateway remains best for beta testers when configured." TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding CopilotProviderSettings}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KyraCardStyle}" Width="300">
                                                <StackPanel>
                                                    <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource KyraAdvancedHeaderBrush}" Text="{Binding FriendlyStatus}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0" FontSize="11.5" Text="{Binding SelectedModelDisplay}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding CredentialBadgeText}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding PrivacyNote}" TextWrapping="Wrap" />
                                                    <WrapPanel>
                                                        <CheckBox Margin="0,0,12,8" Content="Enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                        <Button MinWidth="104" Content="Use as default" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.UseProviderAsDefaultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button MinWidth="72" Content="Test" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.TestProviderConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </WrapPanel>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding LastTestResult}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Bring Your Own Key">
                        <ScrollViewer Style="{StaticResource KyraAdvancedScrollViewerStyle}" Padding="0,12,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource KyraCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="BYOK Setup" />
                                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="BYOK is optional. Use a session key for this run, or save a protected local key with Windows user protection when available. Use the model name from your provider dashboard; if a model list cannot be fetched, manual text is supported." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding CopilotProviderSettings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KyraCardStyle}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                                    <UniformGrid Margin="0,8,0,0" Columns="3">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock FontSize="10.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="API key" />
                                                            <PasswordBox PasswordChanged="OnProviderPasswordChanged" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock FontSize="10.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Base URL" />
                                                            <TextBox Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock FontSize="10.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Model" />
                                                            <TextBox Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Enter the model name from your provider dashboard." TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <WrapPanel Margin="0,8,0,0">
                                                        <TextBlock Margin="0,7,8,0" FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Storage:" />
                                                        <ComboBox Width="160" SelectedValue="{Binding KeyStorageMode, Mode=TwoWay}" SelectedValuePath="Content">
                                                            <ComboBoxItem Content="session" />
                                                            <ComboBoxItem Content="encrypted-local" />
                                                            <ComboBoxItem Content="environment" />
                                                        </ComboBox>
                                                        <Button Content="Save key" MinWidth="96" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.SaveProviderKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Content="Clear saved key" MinWidth="120" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.ClearProviderKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Content="Test connection" MinWidth="124" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.TestProviderConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </WrapPanel>

                                                    <TextBlock FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding SavedKeyStatus}" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding LastTestResult}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Header="Advanced environment setup" IsExpanded="False">
                                    <Border Style="{StaticResource KyraCardStyle}">
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding CopilotProviderEnvironmentHelpText}" TextWrapping="Wrap" />
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Live Tools">
                        <ScrollViewer Style="{StaticResource KyraAdvancedScrollViewerStyle}" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Tool Readiness" />
                                <TextBlock Margin="0,6,0,12" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="These tools help Kyra answer current information questions. Web Search is first-class: it is ready when gateway search or a BYOK search provider is configured." TextWrapping="Wrap" />

                                <WrapPanel>
                                    <Border Style="{StaticResource KyraCardStyle}" Width="300">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" FontSize="14" Text="Web Search" />
                                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource KyraAdvancedHeaderBrush}" Text="Gateway search available or Not configured" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Lets Kyra look up current external information instead of guessing from local scan data." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KyraCardStyle}" Width="300">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" FontSize="14" Text="System Intelligence" />
                                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource KyraAdvancedHeaderBrush}" Text="Local only" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Gives Kyra sanitized local hardware and toolkit facts." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding KyraToolStatusRows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource KyraCardStyle}" Width="300">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding ToolName}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource KyraAdvancedHeaderBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="11.5" Text="{Binding Provider}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding Notes}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <Button Content="Save Live Tool Settings" MinWidth="170" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveKyraLiveToolsSettingsCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Privacy &amp; Context">
                        <ScrollViewer Style="{StaticResource KyraAdvancedScrollViewerStyle}" Padding="0,12,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource KyraCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Privacy Controls" />
                                        <CheckBox Margin="0,10,0,6" IsChecked="{Binding AllowOnlineSystemContextSharing, Mode=TwoWay}" Content="Send sanitized system summary to online AI" />
                                        <CheckBox Margin="0,0,0,6" IsChecked="{Binding KyraPersistentMemoryEnabled, Mode=TwoWay}" Content="Include recent Kyra chat context" />
                                        <CheckBox Margin="0,0,0,6" IsChecked="{Binding KyraUseSanitizedSystemIntelligenceContext, Mode=TwoWay}" Content="Include System Intelligence results" />
                                        <CheckBox Margin="0,0,0,6" IsChecked="{Binding IncludeUsbToolkitStatusInKyraContext, Mode=TwoWay}" Content="Include USB/toolkit status" />
                                        <CheckBox Margin="0,0,0,6" IsChecked="{Binding KyraRealtimeGatewayResearchEnabled, Mode=TwoWay}" Content="Use live research for current info" />
                                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="API keys are never sent to support email. Private documents are not automatically sent. Serial numbers, private paths, tokens, product keys, and raw logs should be redacted before sharing. Local scan facts are summarized before online use." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KyraCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Sanitized Context Preview" />
                                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding KyraSanitizedContextPreviewText}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Local AI">
                        <ScrollViewer Style="{StaticResource KyraAdvancedScrollViewerStyle}" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Local AI and Offline Fallback" />
                                <TextBlock Margin="0,6,0,12" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Ollama, LM Studio, and Offline Local Kyra do not require a cloud API key. Offline fallback remains the safety net." TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding LocalAiProviderSettings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KyraCardStyle}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource KyraAdvancedHeaderBrush}" Text="{Binding ProviderStatusLabel}" TextWrapping="Wrap" />
                                                    <UniformGrid Margin="0,8,0,0" Columns="2">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock FontSize="10.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Endpoint" />
                                                            <TextBox Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock FontSize="10.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Model" />
                                                            <TextBox Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Enter the model name from your provider dashboard." TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <CheckBox Margin="0,7,12,8" Content="Enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                        <Button Content="Test connection" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.TestProviderConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </WrapPanel>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="No cloud API key required." TextWrapping="Wrap" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="{Binding LastTestResult}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Diagnostics">
                        <ScrollViewer Style="{StaticResource KyraAdvancedScrollViewerStyle}" Padding="0,12,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource KyraCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KyraSectionTitleStyle}" Text="Friendly Diagnostics" />
                                        <TextBlock Margin="0,8,0,0" Text="{Binding CopilotActiveProviderText}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding CopilotOnlineStatusText}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding CopilotLastProviderFailureText}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding KyraGatewayProviderStatusSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Expander Header="Show technical diagnostics" IsExpanded="False">
                                    <Border Style="{StaticResource KyraCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="12" Text="{Binding CopilotDiagnosticsSummaryText}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" FontSize="12" Text="{Binding CopilotRoutingPolicyText}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" FontSize="12" Text="{Binding KyraProviderHubConfigHealthSummary}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource KyraAdvancedMutedTextBrush}" Text="Technical diagnostics are sanitized: no raw API keys, tokens, serials, private paths, or full exception chains." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="12,10"
                    Background="#B30A111C"
                    BorderBrush="#6657C7E8"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource KyraAdvancedMutedTextBrush}"
                               Text="Keys are hidden. Diagnostics are sanitized. Offline Local Kyra remains available."
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh Status" Command="{Binding RefreshCopilotProviderStatusCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Copy Diagnostics" Command="{Binding CopyDiagnosticsCommandSummaryCommand}" />
                    <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Content="Close" Click="OnCloseClick" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
