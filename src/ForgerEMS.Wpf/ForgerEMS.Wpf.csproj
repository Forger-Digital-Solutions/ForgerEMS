<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>ForgerEMS</AssemblyName>
    <Product>ForgerEMS</Product>
    <Company>Forger Digital Solutions</Company>
    <Title>ForgerEMS v1.2.1 Public Preview</Title>
    <Description>ForgerEMS Public Preview — Windows technician suite (USB toolkit, System Intelligence, Kyra offline-first).</Description>
    <Authors>Forger Digital Solutions</Authors>
    <ApplicationIcon>Assets\ForgerEMS.ico</ApplicationIcon>
    <Version>1.2.1-preview.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <InformationalVersion>1.2.1-preview.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;.artifacts\**</DefaultItemExcludes>
    <ForgerNuGetPackageRoot Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)</ForgerNuGetPackageRoot>
    <ForgerNuGetPackageRoot Condition="'$(ForgerNuGetPackageRoot)' == '' and '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)\</ForgerNuGetPackageRoot>
    <ForgerNuGetPackageRoot Condition="'$(ForgerNuGetPackageRoot)' == ''">$(UserProfile)\.nuget\packages\</ForgerNuGetPackageRoot>
    <ForgerLibreHardwareMonitorDll>$(ForgerNuGetPackageRoot)librehardwaremonitorlib\0.9.6\runtimes\win-x64\lib\net8.0\LibreHardwareMonitorLib.dll</ForgerLibreHardwareMonitorDll>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForgerEMS.Wpf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ForgerEMS.ico" />
    <Resource Include="Assets\ForgerEMS_Icon.png" />
    <Resource Include="Assets\ForgerEMS_CommandCenterBackground.png" />
    <Resource Include="Assets\Kyra.png" />
    <Resource Include="Assets\KyraAdvancedBackground.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\providers\sensors\**\*">
      <Link>providers\sensors\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="$(ForgerLibreHardwareMonitorDll)" Condition="Exists('$(ForgerLibreHardwareMonitorDll)')">
      <Link>providers\sensors\LibreHardwareMonitorLib.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyLibreHardwareMonitorProviderToOutput" AfterTargets="Build" Condition="Exists('$(ForgerLibreHardwareMonitorDll)')">
    <Copy SourceFiles="$(ForgerLibreHardwareMonitorDll)" DestinationFiles="$(OutputPath)providers\sensors\LibreHardwareMonitorLib.dll" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLibreHardwareMonitorProviderToPublish" AfterTargets="Publish" Condition="Exists('$(ForgerLibreHardwareMonitorDll)')">
    <Copy SourceFiles="$(ForgerLibreHardwareMonitorDll)" DestinationFiles="$(PublishDir)providers\sensors\LibreHardwareMonitorLib.dll" SkipUnchangedFiles="true" />
  </Target>

</Project>
