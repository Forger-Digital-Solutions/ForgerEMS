  <Target Name="CopyLibreHardwareMonitorProviderToOutput" AfterTargets="Build" Condition="Exists('$(ForgerLibreHardwareMonitorDll)')">
    <Copy SourceFiles="$(ForgerLibreHardwareMonitorDll)" DestinationFiles="$(OutputPath)providers\sensors\LibreHardwareMonitorLib.dll" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLibreHardwareMonitorProviderToPublish" AfterTargets="CopyFilesToPublishDirectory">
    <Error Condition="!Exists('$(ForgerLibreHardwareMonitorDll)')" Text="LibreHardwareMonitorLib runtime asset not found at $(ForgerLibreHardwareMonitorDll) — restore packages first." />
    <Copy Condition="'$(PublishDir)' != ''" SourceFiles="$(ForgerLibreHardwareMonitorDll)" DestinationFiles="$(PublishDir)providers\sensors\LibreHardwareMonitorLib.dll" SkipUnchangedFiles="true" />
  </Target>

  <!-- LGPL replaceability: keep the LibreHardwareMonitorLib assembly OUT of the single-file
       bundle so a modified LGPL-covered component can be swapped by the user. The loose DLL
       is staged at the publish root AND under providers\sensors (the app's provider probe
       path); both copies are byte-identical upstream binaries, never modified. The metadata
       must be applied after ComputeResolvedFilesToPublishList produces ResolvedFileToPublish
       but before _ComputeResolvedFilesToPublishTypes splits the unbundled copy lists. -->
  <Target Name="ExcludeLibreHardwareMonitorFromSingleFile"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Filename)' == 'LibreHardwareMonitorLib'"
                             ExcludeFromSingleFile="true"
                             CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>

