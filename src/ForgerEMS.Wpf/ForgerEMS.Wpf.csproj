<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>ForgerEMS</AssemblyName>
    <Product>ForgerEMS</Product>
    <Company>Forger Digital Solutions</Company>
    <Title>ForgerEMS v$(ForgerEMSReleaseVersion)</Title>
    <Description>ForgerEMS - Windows technician utility suite for USB toolkit workflows, Driver Hub guidance, port/USB mapping, drive validation, and battery/system summaries.</Description>
    <Authors>Forger Digital Solutions</Authors>
    <ApplicationIcon>Assets\ForgerEMS.ico</ApplicationIcon>
    <Version>$(ForgerEMSReleaseVersion)</Version>
    <AssemblyVersion>$(ForgerEMSReleaseVersion).0</AssemblyVersion>
    <FileVersion>$(ForgerEMSReleaseVersion).0</FileVersion>
    <InformationalVersion>$(ForgerEMSReleaseVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;.artifacts\**</DefaultItemExcludes>
    <ForgerNuGetPackageRoot Condition="'$(NuGetPackageRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)'))</ForgerNuGetPackageRoot>
    <ForgerNuGetPackageRoot Condition="'$(ForgerNuGetPackageRoot)' == '' and '$(NUGET_PACKAGES)' != ''">$([MSBuild]::NormalizeDirectory('$(NUGET_PACKAGES)'))</ForgerNuGetPackageRoot>
    <ForgerNuGetPackageRoot Condition="'$(ForgerNuGetPackageRoot)' == ''">$(UserProfile)\.nuget\packages\</ForgerNuGetPackageRoot>
    <ForgerLibreHardwareMonitorDll>$(ForgerNuGetPackageRoot)librehardwaremonitorlib\0.9.6\runtimes\win-x64\lib\net8.0\LibreHardwareMonitorLib.dll</ForgerLibreHardwareMonitorDll>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForgerEMS.Wpf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ForgerEMS.ico" />
    <Resource Include="Assets\ForgerEMS_Icon.png" />
    <Resource Include="Assets\ForgerEMS_CommandCenterBackground.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\providers\sensors\**\*">
      <Link>providers\sensors\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(ForgerLibreHardwareMonitorDll)" Condition="Exists('$(ForgerLibreHardwareMonitorDll)')">
      <Link>providers\sensors\LibreHardwareMonitorLib.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

