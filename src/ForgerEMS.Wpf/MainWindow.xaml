                                            Padding="12"
                                            Background="#B80A101A"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PanelLabelBrush}"
                                                       Text="Selected Tool Detail" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding SelectedToolkitDetailText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PanelLabelBrush}"
                                                       Text="Expected full path" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding SelectedToolkitExpectedFullPath}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PanelLabelBrush}"
                                                       Text="Detected full path" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding SelectedToolkitDetectedFullPath}"
                                                       TextWrapping="Wrap" />
