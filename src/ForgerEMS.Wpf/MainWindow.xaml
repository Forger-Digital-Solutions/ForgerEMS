                                                <Button Style="{StaticResource KyraQuickActionChipButtonStyle}" Content="Check live tools" Command="{Binding AskCopilotLiveToolsCommand}" Visibility="{Binding KyraLiveToolsQuickButtonVisibility}" />
                                            </WrapPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1"
                                            MinHeight="260"
                                            Padding="10,9"
                                            Background="#D40A121D"
                                            BorderBrush="#44587996"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <ScrollViewer x:Name="KyraChatScrollViewer"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Style="{StaticResource CopilotChatScrollViewerStyle}">
                                                <ItemsControl ItemsSource="{Binding CopilotMessages}"
                                                              Width="{Binding ActualWidth, ElementName=KyraChatScrollViewer}"
                                                              MaxWidth="900"
                                                              HorizontalAlignment="Center">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,6"
                                                                    Padding="10,8"
                                                                    Background="#BA101A29"
                                                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    MaxWidth="760">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                                        <Setter Property="Background" Value="#BA101A29" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Role}" Value="You">
                                                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                                                <Setter Property="Background" Value="#C0192434" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel MaxWidth="740">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock FontWeight="SemiBold"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource PanelLabelBrush}"
                                                                                   Text="{Binding Role}" />
                                                                        <Button Grid.Column="1"
                                                                                Style="{StaticResource KyraMessageCopyButtonStyle}"
                                                                                Visibility="{Binding CopyVisibility}"
                                                                                Content="Copy"
                                                                                Click="OnCopyCopilotResponseClick" />
                                                                    </Grid>
                                                                    <TextBlock Margin="0,5,0,0"
                                                                               FontSize="13.5"
                                                                               LineHeight="20"
                                                                               LineStackingStrategy="BlockLineHeight"
                                                                               Foreground="{DynamicResource PanelTextBrush}"
                                                                               Text="{Binding Text}"
                                                                               TextWrapping="Wrap" />
                                                                    <Border Margin="0,6,0,0"
                                                                            Padding="6,2.5"
                                                                            Background="#3A2A3A52"
                                                                            CornerRadius="999"
                                                                            Visibility="{Binding HasMetadataSummary, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock FontSize="10.5"
                                                                                   Foreground="{DynamicResource PanelMutedTextBrush}"
                                                                                   Text="{Binding MetadataSummary}" />
                                                                    </Border>
                                                                    <StackPanel Margin="0,8,0,0"
                                                                                Orientation="Vertical"
                                                                                Visibility="{Binding KyraFeedbackPanelVisibility}">
                                                                        <TextBlock Margin="0,0,0,4"
                                                                                   FontSize="10.5"
                                                                                   Foreground="{DynamicResource PanelMutedTextBrush}"
                                                                                   Text="Did this help?"
                                                                                   TextWrapping="Wrap" />
                                                                        <WrapPanel>
                                                                            <Button MinWidth="92"
                                                                                    Margin="0,0,6,6"
                                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                                    Content="This fixed it"
                                                                                    Command="{Binding DataContext.KyraFeedbackThisFixedItCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button MinWidth="92"
                                                                                    Margin="0,0,6,6"
                                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                                    Content="Still broken"
                                                                                    Command="{Binding DataContext.KyraFeedbackStillBrokenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button MinWidth="72"
                                                                                    Margin="0,0,6,6"
                                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                                    Content="Not sure"
                                                                                    Command="{Binding DataContext.KyraFeedbackNotSureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button MinWidth="124"
                                                                                    Margin="0,0,6,6"
                                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                                    Content="Save as repair note"
                                                                                    Command="{Binding DataContext.KyraFeedbackSaveRepairNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0"
                                                    Margin="0,0,0,6"
                                                    Visibility="{Binding CopilotThinkingVisibility}">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFDAB8"
                                                       Text="Kyra is working…" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="#CCFFDAB8"
                                                       Text="{Binding KyraActivityStatusText}" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="KyraChatInputBox"
                                                     MinHeight="42"
                                                     Style="{StaticResource KyraChatInputTextBoxStyle}"
                                                     Text="{Binding CopilotInput, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     ToolTip="Type a message or a slash command (/help, /diagnose, /usb, /resale…). Tab completes the first suggestion."
                                                     PreviewKeyDown="OnCopilotInputPreviewKeyDown" />
                                            <Popup PlacementTarget="{Binding ElementName=KyraChatInputBox}"
                                                   Placement="Top"
                                                   StaysOpen="True"
                                                   AllowsTransparency="True"
                                                   IsOpen="{Binding KyraSlashPopupOpen, Mode=TwoWay}">
                                                <Border Padding="4"
                                                        Background="#F20A101A"
                                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        MaxWidth="420">
                                                    <ListBox x:Name="KyraSlashSuggestionList"
                                                             ItemsSource="{Binding KyraSlashSuggestions}"
                                                             SelectedIndex="{Binding KyraSlashSelectedIndex, Mode=TwoWay}"
                                                             MaxHeight="220"
                                                             MinWidth="260"
                                                             FontSize="13"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Focusable="False"
                                                             IsTabStop="False"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             PreviewMouseLeftButtonUp="OnKyraSlashSuggestionClick"
                                                             MouseMove="OnKyraSlashListMouseMove">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding" Value="10,7" />
                                                                <Setter Property="MinHeight" Value="32" />
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                    </ListBox>
                                                </Border>
                                            </Popup>
                                            <TextBlock Margin="14,0,14,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Foreground="#99E0E8F5"
                                                       Text="Ask Kyra or type /help for slash commands (e.g. /diagnose, /usb, /resale)…"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding CopilotInputPlaceholderVisibility}" />
                                        </Grid>
                                        <Button Grid.Column="1"
                                                Width="110"
                                                Margin="8,0,0,0"
                                                Content="Send"
                                                Command="{Binding SendCopilotMessageCommand}" />
                                        <Button Grid.Column="2"
                                                Width="104"
                                                Margin="6,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Clear Chat"
                                                Command="{Binding ClearCopilotHistoryCommand}" />
                                        <Button Grid.Column="3"
                                                Width="126"
                                                Margin="6,0,0,0"
                                                Visibility="{Binding StopCopilotGenerationVisibility}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Stop"
                                                Command="{Binding StopCopilotGenerationCommand}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="⚙  Diagnostics">
                        <StackPanel Margin="24,0,24,0" MaxWidth="1040" HorizontalAlignment="Left">
                            <GroupBox Header="App Diagnostics">
                                <StackPanel>
                                    <Border Margin="0,0,0,12" Padding="12" Background="#FF0A101A" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="1) Mission Control" />
                                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding UnifiedDiagnosticsSummaryText}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource PanelMutedTextBrush}" Text="{Binding DiagnosticsWarningReasonText}" TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="{Binding DiagnosticsAppActionStatusText}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipWarningStyle}"><TextBlock Text="{Binding DiagnosticsHealthStatusText}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipProblemStyle}"><TextBlock Text="{Binding DiagnosticsBackendChipText}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipNeutralStyle}"><TextBlock Text="{Binding DiagnosticsUsbChipText}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="{Binding DiagnosticsSystemChipText}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipWarningStyle}"><TextBlock Text="{Binding DiagnosticsToolkitChipText}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="{Binding DiagnosticsKyraChipText}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipNeutralStyle}"><TextBlock Text="{Binding DiagnosticsUpdateChipText}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <GroupBox Margin="0,0,0,12" Header="2) Evidence &amp; Logs">
                                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Last command evidence" />
                                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding LastCommandNameText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource PanelMutedTextBrush}" Text="{Binding LastCommandToolText}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,6,0,8">
                                                    <TextBlock Margin="0,0,14,0" FontSize="11" Foreground="{DynamicResource PanelMutedTextBrush}" Text="{Binding LastCommandStatusText, StringFormat=Status: {0}}" />
                                                    <TextBlock Margin="0,0,14,0" FontSize="11" Foreground="{DynamicResource PanelMutedTextBrush}" Text="{Binding LastCommandStartedText, StringFormat=Started: {0}}" />
                                                    <TextBlock Margin="0,0,14,0" FontSize="11" Foreground="{DynamicResource PanelMutedTextBrush}" Text="{Binding LastCommandFinishedText, StringFormat=Finished: {0}}" />
                                                    <TextBlock Margin="0,0,14,0" FontSize="11" Foreground="{DynamicResource PanelMutedTextBrush}" Text="{Binding LastCommandDurationText, StringFormat=Duration: {0}}" />
                                                    <TextBlock Margin="0,0,14,0" FontSize="11" Foreground="{DynamicResource PanelMutedTextBrush}" Text="{Binding LastCommandExitCodeText, StringFormat=Exit: {0}}" />
                                                </WrapPanel>
                                                <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding LastCommandSummaryText}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,0,0,8">
                                                    <Button MinWidth="170" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Copy command summary" Command="{Binding CopyDiagnosticsCommandSummaryCommand}" />
                                                    <Button MinWidth="160" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Copy safe summary" Command="{Binding CopySafeTestingSummaryCommand}" />
                                                    <Button MinWidth="130" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Open related log" Command="{Binding OpenLogsFolderCommand}" />
                                                    <Button MinWidth="180" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Open output folder/report" Command="{Binding OpenReportsFolderCommand}" />
                                                </WrapPanel>
                                                <CheckBox Margin="4,0,0,8" Content="Show full diagnostic detail" IsChecked="{Binding DiagnosticsShowFullDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Padding="4" FontSize="12" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding DiagnosticsHealthChecklistText}" TextWrapping="Wrap" />
                                                <Grid Margin="0,8,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding DiagnosticsLogSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search live logs" />
                                                    <TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PanelLabelBrush}" Text="Level" />
                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding LogLevelFilterOptions}" SelectedItem="{Binding SelectedLogLevelFilter}" />
                                                </Grid>
                                                <WrapPanel>
                                                    <Button MinWidth="150" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Content="Copy last 200 lines" Command="{Binding CopyLast200LogsCommand}" />
                                                    <Button MinWidth="120" Style="{StaticResource SecondaryButtonStyle}" Content="Open full logs" Command="{Binding OpenLogsFolderCommand}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </GroupBox>

                                    <Expander Margin="0,8,0,0" Header="3) Safety Lab" IsExpanded="False" Style="{StaticResource DiagnosticsExpanderStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource PanelTextBrush}" TextWrapping="Wrap" Text="ForgerEMS can flag obvious risks and compute hashes, but cannot guarantee files are safe." />
                                            <GroupBox Margin="0,10,0,0" Header="Command Center / Safe Checks">
                                                <StackPanel>
                                                    <TextBlock Margin="0,0,0,10" FontSize="11.5" Foreground="{DynamicResource PanelMutedTextBrush}" TextWrapping="Wrap" Text="Embedded terminal is deferred until it has sandboxing, allowlist mode, timeout, and kill switch." />
                                                    <WrapPanel>
                                                        <Button MinWidth="150" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Check WSL installed" Command="{Binding CheckWslInstalledCommand}" />
                                                        <Button MinWidth="140" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Show WSL distros" Command="{Binding ShowWslDistrosCommand}" />
                                                        <Button MinWidth="170" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Check PowerShell version" Command="{Binding CheckPowerShellVersionCommand}" />
                                                        <Button MinWidth="140" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Check backend files" Command="{Binding CheckBackendFilesCommand}" />
                                                        <Button MinWidth="140" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Check release identity" Command="{Binding CheckReleaseIdentityCommand}" />
                                                        <Button MinWidth="130" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Check network/DNS" Command="{Binding CheckNetworkDnsCommand}" />
                                                        <Button MinWidth="190" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Open external WSL terminal" Command="{Binding OpenUbuntuTerminalCommand}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </GroupBox>
                                            <Expander Margin="0,10,0,0" Header="Link / Download Safety Checker (beta)" IsExpanded="False" Style="{StaticResource DiagnosticsExpanderStyle}">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource PanelTextBrush}" TextWrapping="Wrap" Text="Analyze checks URL metadata with HEAD and safe bounded GET fallback. Quarantine download saves to a neutral ForgerEMS quarantine file only after explicit action. ForgerEMS never executes, shell-opens, or unzips payloads." />
                                                    <TextBox Margin="0,10,0,8" MinHeight="32" FontFamily="Consolas" FontSize="12" Padding="8,6" Background="#FF0E1624" Foreground="{DynamicResource PanelTextBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" TextWrapping="Wrap" AcceptsReturn="False" Text="{Binding LinkSafetyUrlInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <WrapPanel Margin="0,0,0,8">
                                                        <Button MinWidth="120" Margin="0,0,8,8" Content="Analyze URL" Command="{Binding AnalyzeLinkSafetyCommand}" />
                                                        <Button MinWidth="150" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="HTTPS HEAD (optional)" Command="{Binding FetchLinkSafetyHeadersCommand}" />
                                                        <Button MinWidth="210" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Download to quarantine (no run)" Command="{Binding DownloadLinkToQuarantineCommand}" />
                                                    </WrapPanel>
                                                    <TextBox MinHeight="120" MaxHeight="220" FontFamily="Consolas" FontSize="11" Padding="8" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#FF070B12" Foreground="#FFE8F0FF" BorderBrush="{DynamicResource PanelBorderBrush}" Text="{Binding LinkSafetyResultText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Expander>
                                            <Expander Margin="0,10,0,0" Header="Downloaded file / EXE safety (read-only)" IsExpanded="False" Style="{StaticResource DiagnosticsExpanderStyle}">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource PanelTextBrush}" TextWrapping="Wrap" Text="Local file analyzer is read-only and never executes selected files. It computes SHA256 when readable, detects file type from headers, and reports signature metadata when available." />
                                                    <WrapPanel Margin="0,10,0,8">
                                                        <Button MinWidth="160" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Pick file…" Command="{Binding BrowseLocalFileSafetyCommand}" />
                                                        <Button MinWidth="120" Margin="0,0,8,8" Content="Analyze file" Command="{Binding AnalyzeLocalFileSafetyCommand}" />
                                                        <Button MinWidth="118" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Copy SHA256" Command="{Binding CopyLocalFileSafetyShaCommand}" />
                                                        <Button MinWidth="108" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Copy report" Command="{Binding CopyLocalFileSafetyReportCommand}" />
                                                        <Button MinWidth="168" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Open quarantine folder" Command="{Binding OpenLocalSafetyQuarantineFolderCommand}" />
                                                        <Button MinWidth="210" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Copy file to quarantine (no run)" Command="{Binding CopyLocalFileToQuarantineCommand}" />
                                                    </WrapPanel>
                                                    <TextBox Margin="0,0,0,8" MinHeight="32" FontFamily="Consolas" FontSize="12" Padding="8,6" Background="#FF0E1624" Foreground="{DynamicResource PanelTextBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" TextWrapping="Wrap" AcceptsReturn="False" Text="{Binding LocalFileSafetyPath, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox MinHeight="120" MaxHeight="220" FontFamily="Consolas" FontSize="11" Padding="8" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#FF070B12" Foreground="#FFE8F0FF" BorderBrush="{DynamicResource PanelBorderBrush}" Text="{Binding LocalFileSafetyResultText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Expander>
                                            <Expander Margin="0,10,0,0" Header="Safe Testing / Sandbox" IsExpanded="False" Style="{StaticResource DiagnosticsExpanderStyle}">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource PanelMutedTextBrush}" TextWrapping="Wrap" Text="Use Windows Sandbox, VM, or external WSL for risky items. ForgerEMS does not run unknown scripts in-app." />
                                                    <ScrollViewer Margin="0,10,0,10" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <TextBlock Padding="2" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource PanelTextBrush}" TextWrapping="Wrap" Text="{Binding SafeTestingEnvironmentSummaryText}" />
                                                    </ScrollViewer>
                                                    <WrapPanel Margin="0,0,0,8">
                                                        <Button MinWidth="200" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh safe testing status" Command="{Binding RefreshSafeTestingEnvironmentCommand}" />
                                                        <Button MinWidth="220" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Open Windows Sandbox settings/help" Command="{Binding OpenWindowsSandboxHelpCommand}" />
                                                        <Button MinWidth="190" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Content="Open WSL Terminal externally" Command="{Binding OpenUbuntuTerminalCommand}" />
                                                    </WrapPanel>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource PanelMutedTextBrush}" TextWrapping="Wrap" Text="{Binding WindowsSandboxStatusText}" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="☰  Settings">
                        <StackPanel Margin="24,0,24,0" MaxWidth="1040" HorizontalAlignment="Left">
                            <GroupBox Header="Settings">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="Public Preview" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                        <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="Local-first" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                        <Border Style="{StaticResource DiagnosticsStatusChipWarningStyle}"><TextBlock Text="Beta honesty" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                    </WrapPanel>
                                    <GroupBox Margin="0,0,0,14" Header="Public Preview — feature maturity">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,8">
                                                <Border Style="{StaticResource DiagnosticsStatusChipNeutralStyle}"><TextBlock Text="Preview build" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipWarningStyle}"><TextBlock Text="Some coverage varies" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                            </WrapPanel>
                                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                <TextBlock FontSize="11.5"
                                                           Foreground="{DynamicResource PanelTextBrush}"
                                                           Text="{Binding FeatureMaturityGuideText}"
                                                           TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Margin="0,0,0,14" Header="System Intelligence sensors / Deep Sensor Mode">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,8">
                                                <Border Style="{StaticResource DiagnosticsStatusChipNeutralStyle}"><TextBlock Text="Mode: Off / Read-only local sensors" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="Safety: read-only" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                            </WrapPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Mode" />
                                                <ComboBox Grid.Row="0"
                                                          Grid.Column="1"
                                                          Width="260"
                                                          HorizontalAlignment="Left"
                                                          SelectedIndex="{Binding DeepSensorModeSelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="Off" />
                                                    <ComboBoxItem Content="Read-only local sensors" />
                                                </ComboBox>
                                                <TextBlock Grid.Row="1" Margin="0,8,12,0" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Source" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding DeepSensorModeSourceSummary}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2" Margin="0,8,12,0" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Safety" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Foreground="{DynamicResource PanelTextBrush}" Text="Read-only. No fan, voltage, clock, BIOS, or firmware control." TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="3" Margin="0,8,12,0" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Limitations" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Foreground="{DynamicResource PanelMutedTextBrush}" Text="{Binding DeepSensorModeConsentNotice}" TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Margin="0,0,0,14" Header="Kyra Intelligence (Beta)">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,8">
                                                <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="Local Only available" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipWarningStyle}"><TextBlock Text="Sharing preview/off by default" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                            </WrapPanel>
                                            <TextBlock Margin="0,0,0,10"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="We never send API keys, passwords, product keys, serial numbers, private files, private documents, full local paths, emails, IP addresses, or exact location. You can keep Kyra local-only and change this anytime in Settings."
                                                       TextWrapping="Wrap" />

                                            <CheckBox IsChecked="{Binding KyraLocalRepairMemoryEnabled, Mode=TwoWay}"
                                                      Content="Local Kyra Memory: store sanitized repair notes on this PC" />
                                            <TextBlock Margin="24,2,0,8"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="Stores sanitized repair notes and categories on this machine only. You can export or delete anytime."
                                                       TextWrapping="Wrap" />

                                            <CheckBox IsChecked="{Binding KyraRealtimeGatewayEnabled, Mode=TwoWay}"
                                                      Content="ForgerEMS Kyra Gateway (server-side providers)" />
                                            <TextBlock Margin="24,2,0,8"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="Uses the configured gateway when available. Provider API keys stay on the server, not in this app."
                                                       TextWrapping="Wrap" />

                                            <CheckBox IsChecked="{Binding KyraRealtimeGatewayResearchEnabled, Mode=TwoWay}"
                                                      Content="Gateway Research: fetch realtime public info when needed" />
                                            <TextBlock Margin="24,2,0,8"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="Sends only sanitized request context needed for live answers. If the gateway is unavailable, Kyra says so honestly."
                                                       TextWrapping="Wrap" />

                                            <CheckBox IsChecked="{Binding KyraUseSanitizedSystemIntelligenceContext, Mode=TwoWay}"
                                                      Content="Use System Intelligence Context: local scan summaries for Kyra" />
                                            <TextBlock Margin="24,2,0,8"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="Includes compact, redacted device headlines in prompts and gateway research when enabled."
                                                       TextWrapping="Wrap" />

                                            <CheckBox IsChecked="{Binding KyraCommunitySharingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Community Intelligence Sharing: preview/off by default" />
                                            <TextBlock Margin="24,2,0,8"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="Optionally share anonymous diagnostic patterns to improve Kyra for everyone. Community upload is disabled in this beta foundation."
                                                       TextWrapping="Wrap" />

                                            <CheckBox Margin="0,0,0,4"
                                                      IsEnabled="{Binding KyraCommunitySharingEnabled}"
                                                      IsChecked="{Binding KyraShareResolvedIssueFixPatterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Share resolved issue/fix categories" />
                                            <CheckBox Margin="0,0,0,4"
                                                      IsEnabled="{Binding KyraCommunitySharingEnabled}"
                                                      IsChecked="{Binding KyraShareHardwareCompatibilityPerformancePatterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Share anonymous hardware compatibility/performance patterns" />
                                            <CheckBox Margin="0,0,0,10"
                                                      IsEnabled="{Binding KyraCommunitySharingEnabled}"
                                                      IsChecked="{Binding KyraShareCrashErrorDiagnostics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Share crash/error diagnostics" />

                                            <WrapPanel>
                                                <Button MinWidth="134"
                                                        Margin="0,0,8,8"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Keep Local Only"
                                                        Command="{Binding KeepKyraLocalOnlyCommand}" />
                                                <Button MinWidth="144"
                                                        Margin="0,0,8,8"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Help Improve Kyra"
                                                        Command="{Binding EnableKyraCommunityLearningCommand}" />
                                                <Button MinWidth="96"
                                                        Margin="0,0,8,8"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Learn More"
                                                        Command="{Binding LearnMoreKyraIntelligenceCommand}" />
                                            </WrapPanel>

                                            <WrapPanel Margin="0,4,0,0">
                                                <Button MinWidth="160"
                                                        Margin="0,0,8,8"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="View Shared Preview"
                                                        Command="{Binding ViewKyraCommunityPayloadPreviewCommand}" />
                                                <Button MinWidth="138"
                                                        Margin="0,0,8,8"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Export Memory"
                                                        Command="{Binding ExportKyraIntelligenceMemoryCommand}" />
                                                <Button MinWidth="138"
                                                        Margin="0,0,8,8"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Delete Memory"
                                                        Command="{Binding DeleteKyraIntelligenceMemoryCommand}" />
                                                <Button MinWidth="138"
                                                        Margin="0,0,8,8"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Reset Learning"
                                                        Command="{Binding ResetKyraMachineLearningCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <Border Margin="0,0,0,14"
                                            Padding="12"
                                            Visibility="{Binding BetaTesterEntitlementVisibility}"
                                            Background="#FFFFE7C2"
                                            BorderBrush="#FFFFB86B"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <TextBlock Foreground="#FF111111"
                                                   FontWeight="Bold"
                                                   Text="Beta Tester: Pro access unlocked during beta"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <GroupBox Margin="0,0,0,14" Header="Network Pulse">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,8">
                                                <Border Style="{StaticResource DiagnosticsStatusChipNeutralStyle}"><TextBlock Text="Lightweight" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="Privacy-safe" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="Measured vs estimated" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                            </WrapPanel>
                                            <TextBlock Margin="0,0,0,10"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="Small HTTPS/ICMP checks only. Not a full speed test. Adapter link speed is never shown as internet speed."
                                                       TextWrapping="Wrap" />
                                            <CheckBox IsChecked="{Binding NetworkPulse.NetworkPulseEnabled, Mode=TwoWay}"
                                                      Content="Enable Network Pulse" />
                                            <CheckBox Margin="0,6,0,0"
                                                      IsChecked="{Binding NetworkPulse.NetworkPulseShowInHeader, Mode=TwoWay}"
                                                      Content="Show in header" />
                                            <CheckBox Margin="0,6,0,0"
                                                      IsChecked="{Binding NetworkPulse.NetworkPulseAutoTestSpeed, Mode=TwoWay}"
                                                      Content="Auto-test speed lightly (small download samples)" />
                                            <CheckBox Margin="0,6,0,0"
                                                      IsChecked="{Binding NetworkPulse.NetworkPulseUploadProbesEnabled, Mode=TwoWay}"
                                                      Content="Upload probes (off by default; small POST when enabled)" />
                                            <CheckBox Margin="0,6,0,0"
                                                      IsChecked="{Binding NetworkPulse.NetworkPulsePauseOnMetered, Mode=TwoWay}"
                                                      Content="Pause on metered networks" />
                                            <CheckBox Margin="0,6,0,0"
                                                      IsChecked="{Binding NetworkPulse.NetworkPulsePauseOnBatterySaver, Mode=TwoWay}"
                                                      Content="Pause on battery saver" />
                                            <CheckBox Margin="0,6,0,0"
                                                      IsChecked="{Binding NetworkPulse.NetworkPulsePauseDuringHostHeavy, Mode=TwoWay}"
                                                      Content="Pause during busy ForgerEMS network / update / USB benchmark work" />
                                            <TextBlock Margin="0,14,0,6"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PanelLabelBrush}"
                                                       Text="Mode" />
                                            <ComboBox Width="220"
                                                      HorizontalAlignment="Left"
                                                      SelectedIndex="{Binding NetworkPulse.NetworkPulseModeSelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="Light (slowest cadence, smallest samples)" />
                                                <ComboBoxItem Content="Balanced (default)" />
                                                <ComboBoxItem Content="Full (more frequent, larger cap)" />
                                            </ComboBox>
                                            <TextBlock Margin="0,10,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding NetworkPulse.NetworkPulseIntervalSummaryText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Margin="0,0,0,14" Header="App Updates">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,8">
                                                <Border Style="{StaticResource DiagnosticsStatusChipNeutralStyle}"><TextBlock Text="{Binding AppUpdateMachineStateDisplay}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                                <Border Style="{StaticResource DiagnosticsStatusChipReadyStyle}"><TextBlock Text="{Binding AppUpdateIncludePrereleasesValueText, StringFormat=Prereleases: {0}}" Style="{StaticResource DiagnosticsStatusChipTextStyle}" /></Border>
                                            </WrapPanel>
                                            <TextBlock Margin="0,8,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding AppUpdateSettingsVersionSummary}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding AppUpdateSettingsLatestSummary}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding LastUpdateCheckDisplayText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding AppUpdateMachineStateDisplay, StringFormat=Update status: {0}}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding AppUpdateIncludePrereleasesValueText, StringFormat=Include prereleases: {0}}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding AppUpdateLatestReleaseTagDisplay, StringFormat=Latest release tag: {0}}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding AppUpdateLatestPublishedDisplay, StringFormat=Latest release published: {0}}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding AppUpdateAssetFoundDisplay, StringFormat=Primary asset: {0}}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding AppUpdateSafeFailureReasonDisplay, StringFormat=Safe failure / detail: {0}}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding AppUpdateSettingsSourceLine}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding AppUpdateSettingsChannelLine}"
                                                       TextWrapping="Wrap" />
                                            <CheckBox Margin="0,8,0,0"
                                                      IsChecked="{Binding IncludeBetaRcChannels, Mode=TwoWay}"
                                                      Content="Include Beta / RC releases from GitHub (recommended for beta testers)" />
                                            <CheckBox Margin="0,6,0,0"
                                                      IsChecked="{Binding CheckForUpdatesAutomatically, Mode=TwoWay}"
                                                      Content="Check automatically" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelTextBrush}"
                                                       Text="{Binding AppUpdateSettingsIgnoredSummary}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding AppUpdateSettingsIgnoredVisibility}" />
                                            <Button Margin="0,6,0,0"
                                                    MinWidth="160"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Clear ignored version"
                                                    Command="{Binding ClearIgnoredAppUpdateVersionCommand}"
                                                    Visibility="{Binding AppUpdateSettingsIgnoredVisibility}" />
                                            <CheckBox Margin="0,10,0,0"
                                                      IsChecked="{Binding VerboseLiveLogs, Mode=TwoWay}"
                                                      Content="Verbose Live Logs" />
                                            <Button Margin="0,10,0,0"
                                                    MinWidth="120"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding AppUpdateCheckButtonText}"
                                                    Command="{Binding CheckForUpdatesNowCommand}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding AppUpdateCheckHelperText}"
                                                       TextWrapping="Wrap" />
                                            <Button Margin="0,8,0,0"
                                                    MinWidth="220"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Copy Update Diagnostics"
                                                    Command="{Binding CopyUpdateDiagnosticsCommand}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="Copies a safe summary for support sharing."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </GroupBox>

                                    <WrapPanel>
                                        <Button MinWidth="90"
                                                Margin="0,0,8,8"
                                                Style="{StaticResource FooterButtonStyle}"
                                                Content="About"
                                                Command="{Binding ShowAboutCommand}" />
                                        <Button MinWidth="90"
                                                Margin="0,0,8,8"
                                                Style="{StaticResource FooterButtonStyle}"
                                                Content="FAQ"
                                                Command="{Binding ShowFaqCommand}" />
                                        <Button MinWidth="90"
                                                Margin="0,0,8,8"
                                                Style="{StaticResource FooterButtonStyle}"
                                                Content="Legal"
                                                Command="{Binding ShowLegalCommand}" />
                                        <Button MinWidth="90"
                                                Margin="0,0,8,8"
                                                Style="{StaticResource FooterButtonStyle}"
                                                Content="Privacy"
                                                Command="{Binding ShowPrivacyCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </ScrollViewer>

        </Grid>

        </Grid>

        <Grid x:Name="BetaWelcomeOverlay"
              Panel.ZIndex="45"
              Visibility="{Binding BetaWelcomeVisibility}"
              Background="#C9000000">
            <Border Width="620"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F0080D14"
                    BorderBrush="#FFFFB86B"
                    BorderThickness="1.2"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontFamily="Bahnschrift SemiCondensed"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFFFDAB8"
                               Text="Welcome to ForgerEMS" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#FFB8C5D9"
                               Text="{Binding AppVersionFooterText}" />
                    <TextBlock Margin="0,8,0,14"
                               Foreground="#FFE0E8F4"
                               Text="Public Preview build — confirm the USB target before setup, update, or Ventoy actions. Kyra works offline by default; online providers are optional (Kyra Advanced)."
                               TextWrapping="Wrap" />
                    <TextBlock FontFamily="Bahnschrift SemiCondensed"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFFFDAB8"
                               Text="Help Kyra get smarter for technicians"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,8"
                               Foreground="#FFE0E8F4"
                               TextWrapping="Wrap"
                               Text="Kyra can learn from anonymous repair patterns, diagnostic categories, tool results, and user-confirmed fixes to improve ForgerEMS for everyone." />
                    <TextBlock Margin="0,0,0,10"
                               Foreground="#FFB8C5D9"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="We never share API keys, passwords, product keys, serial numbers, private files, full file paths, emails, IP addresses, exact location, or raw logs. You can keep Kyra local-only and change this anytime in Settings." />
                    <CheckBox Margin="0,0,0,4"
                              Foreground="#FFE0E8F4"
                              Content="Help improve Kyra with anonymous repair intelligence"
                              IsChecked="{Binding BetaWelcomeKyraShareRepairIntelligence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,0,0,4"
                              Foreground="#FFE0E8F4"
                              Content="Share anonymous hardware compatibility/performance patterns"
                              IsChecked="{Binding BetaWelcomeKyraShareHardwarePatterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,0,0,4"
                              Foreground="#FFE0E8F4"
                              Content="Share resolved issue/fix categories"
                              IsChecked="{Binding BetaWelcomeKyraShareResolvedCategories, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,0,0,10"
                              Foreground="#FFE0E8F4"
                              Content="Share crash/error diagnostics"
                              IsChecked="{Binding BetaWelcomeKyraShareCrashDiagnostics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel Margin="0,0,0,14">
                        <Button MinWidth="132"
                                Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Keep Local Only"
                                Command="{Binding BetaWelcomeKyraKeepLocalOnlyCommand}" />
                        <Button MinWidth="148"
                                Margin="0,0,8,8"
                                Content="Help Improve Kyra"
                                Command="{Binding BetaWelcomeKyraHelpImproveCommand}" />
                        <Button MinWidth="168"
                                Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="View What Would Be Shared"
                                Command="{Binding BetaWelcomeKyraViewSharingPreviewCommand}" />
                    </WrapPanel>
                    <TextBlock Foreground="#FFE0E8F4"
                               TextWrapping="Wrap"
                               Text="Suggested first steps: Run Standard Scan, open USB Builder, then select a removable USB before Run USB Benchmark. Open Kyra when you want guided answers. Dismiss anytime — nothing here blocks the app." />
                    <WrapPanel Margin="0,18,0,0">
                        <Button MinWidth="158"
                                Margin="0,0,10,8"
                                Content="Run Standard Scan"
                                Click="OnRunSystemScanFromWelcomeClick" />
                        <Button MinWidth="168"
                                Margin="0,0,10,8"
                                Content="Run USB Benchmark"
                                Click="OnRunUsbBenchmarkFromWelcomeClick" />
                        <Button MinWidth="150"
                                Margin="0,0,10,8"
                                Content="Open USB Builder"
                                Click="OnStartUsbBuilderFromBetaWelcomeClick" />
                        <Button MinWidth="140"
                                Margin="0,0,10,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Open Logs Folder"
                                Click="OnOpenLogsFromBetaWelcomeClick" />
                        <Button MinWidth="140"
                                Margin="0,0,0,8"
                                Style="{StaticResource FooterButtonStyle}"
                                Content="Don't show again"
                                Click="OnDismissBetaWelcomeClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="FullLogsOverlay"
              Panel.ZIndex="40"
              Visibility="Collapsed"
              Background="#B8000000">
            <Border MinWidth="720"
                    Width="960"
                    Height="640"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="20"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F0080D14"
                    BorderBrush="#AA67B7E8"
                    BorderThickness="1"
                    CornerRadius="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,10">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#FFFFDAB8"
                                       Text="Full Logs" />
                            <Button HorizontalAlignment="Right"
                                    MinWidth="96"
                                    Padding="14,8"
                                    Style="{StaticResource FooterButtonStyle}"
                                    Content="Close"
                                    Click="OnCloseFullLogsClick" />
                        </Grid>

                        <WrapPanel Margin="0,0,0,8">
                            <ComboBox Width="132"
                                      MinHeight="34"
                                      Margin="0,0,10,8"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding LogLevelFilterOptions}"
                                      SelectedItem="{Binding SelectedLogLevelFilter}"
                                      Style="{StaticResource ReadableComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}" />
                            <CheckBox MinHeight="34"
                                      Margin="0,0,12,8"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AutoScrollLogs}"
                                      Content="Auto-scroll" />
                            <Button MinWidth="108"
                                    MinHeight="34"
                                    Margin="0,0,8,8"
                                    Padding="12,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Copy logs"
                                    Command="{Binding CopyLogsCommand}" />
                            <Button MinWidth="108"
                                    MinHeight="34"
                                    Margin="0,0,8,8"
                                    Padding="12,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Clear logs"
                                    Command="{Binding ClearLogsCommand}" />
                        </WrapPanel>

                        <WrapPanel>
                            <Button MinWidth="168"
                                    MinHeight="34"
                                    Margin="0,0,8,8"
                                    Padding="12,8"
                                    Style="{StaticResource FooterButtonStyle}"
                                    Content="Copy support email"
                                    Command="{Binding CopySupportEmailCommand}" />
                            <Button MinWidth="168"
                                    MinHeight="34"
                                    Margin="0,0,8,8"
                                    Padding="12,8"
                                    Style="{StaticResource FooterButtonStyle}"
                                    Content="Open support email"
                                    Command="{Binding OpenSupportEmailCommand}" />
                            <Button MinWidth="196"
                                    MinHeight="34"
                                    Margin="0,0,8,8"
                                    Padding="12,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Copy beta report template"
                                    Command="{Binding CopyBetaReportTemplateCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBox x:Name="LogTextBox"
                             Background="#E6050911"
                             BorderBrush="#8867B7E8"
                             BorderThickness="1"
                             Padding="16"
                             FontFamily="Consolas"
                             FontSize="12.5"
                             Foreground="#FFE0E8F4"
                             SelectionBrush="#FFD7B18E"
                             IsReadOnly="True"
                             IsUndoEnabled="False"
                             Text="{Binding LogsText, Mode=OneWay}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Wine / Linux compatibility banner. Sits above all other content
             via Panel.ZIndex; collapses entirely on native Windows. -->
        <Border x:Name="CompatibilityBanner"
                Panel.ZIndex="9999"
                Visibility="{Binding CompatibilityBannerVisibility, FallbackValue=Collapsed}"
                Background="#FF1B2A3A"
                BorderBrush="#FFFBBF24"
                BorderThickness="0,0,0,2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Padding="16,8"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding CompatibilityBannerHeadline}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#FFFBBF24" />
                <TextBlock Text="{Binding CompatibilityBannerBody}"
                           FontSize="12"
                           Margin="0,2,0,0"
                           Foreground="#FFE6EEF8"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding LinuxHelperSummary}"
                           FontSize="11"
                           Margin="0,4,0,0"
                           Foreground="#FFB8C8DA"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LinuxHelperSummary}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
