                                    </Border>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="▤  Toolkit Manager">
                        <StackPanel Margin="24,0,24,0" MaxWidth="1040" HorizontalAlignment="Left">
                            <GroupBox Header="Toolkit Manager">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Style="{StaticResource StatusPillBorderStyle}"
                                                Padding="14,8"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding ToolkitStatusBackground}"
                                                BorderBrush="{Binding ToolkitStatusBorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Style="{StaticResource StatusPillTextStyle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding ToolkitStatusForeground}"
                                                       Text="{Binding ToolkitStatusText}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding ToolkitHealthVerdictText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding ToolkitLastScanText}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,0,0,10"
                                            Padding="10,8"
                                            Background="#B80A101A"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PanelLabelBrush}"
                                                       Text="{Binding ToolkitTargetChipText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding ToolkitTargetHelperText}" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="148" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" MinWidth="148" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" MinWidth="148" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" MinWidth="148" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                Padding="16,10"
                                                Content="Refresh Health"
                                                ToolTip="Fast health refresh: reuses cached verification for unchanged installed files. Use Full Verify for a fresh re-hash."
                                                Command="{Binding RefreshToolkitHealthCommand}" />
                                        <Button Grid.Column="2"
                                                HorizontalAlignment="Stretch"
                                                Padding="16,10"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Full Verify"
                                                ToolTip="Deep verify: re-hash every installed managed file from scratch. Slow on populated USBs."
                                                Command="{Binding FullVerifyToolkitHealthCommand}" />
                                        <Button Grid.Column="4"
                                                HorizontalAlignment="Stretch"
                                                Padding="16,10"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Open Reports"
                                                ToolTip="Open USB reports on the target or local runtime reports."
                                                Command="{Binding OpenToolkitReportsCommand}" />
                                        <Button Grid.Column="6"
                                                HorizontalAlignment="Stretch"
                                                Padding="16,10"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Open Toolkit Folder"
                                                ToolTip="Open the USB toolkit root folder for the selected target."
                                                Command="{Binding OpenToolkitFolderCommand}" />
                                    </Grid>

                                    <TextBlock Margin="0,0,0,12"
                                               FontSize="12"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               Text="{Binding ToolkitManualExplanationText}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Margin="0,0,0,8"
                                               FontSize="12"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               Text="{Binding ToolkitClassificationSummaryText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,0,0,10"
                                               FontSize="12"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               Text="{Binding ToolkitRecommendedUseSummaryText}"
                                               TextWrapping="Wrap" />

                                    <Border Margin="0,0,0,12"
                                            Padding="10"
                                            Background="#B80A101A"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PanelLabelBrush}"
                                                       Text="{Binding ToolkitReadinessScoreText}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding ToolkitReadinessStrengthsText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding ToolkitReadinessBlockersText}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding ToolkitReadinessNextActionText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               Text="{Binding MachineProfileStatusText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               Text="{Binding MachineProfileLastSavedText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               Text="{Binding MachineProfileLastHealthText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,0,0,8"
                                               FontSize="12"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               Text="{Binding MachineProfileLastToolkitReadinessText}"
                                               TextWrapping="Wrap" />

                                    <WrapPanel Margin="0,0,0,12">
                                        <Border MinWidth="145" Margin="0,0,8,8" Style="{StaticResource SuccessPillStyle}">
                                            <TextBlock Style="{StaticResource StatusPillTextStyle}" Foreground="#FF14532D" FontWeight="SemiBold" Text="{Binding ToolkitInstalledCountText}" />
                                        </Border>
                                        <Border MinWidth="175" Margin="0,0,8,8" Style="{StaticResource WarningPillStyle}">
                                            <TextBlock Style="{StaticResource StatusPillTextStyle}" Foreground="#FF92400E" FontWeight="SemiBold" Text="{Binding ToolkitMissingCountText}" />
                                        </Border>
                                        <Border MinWidth="130" Margin="0,0,8,8" Style="{StaticResource WarningPillStyle}">
                                            <TextBlock Style="{StaticResource StatusPillTextStyle}" Foreground="#FF92400E" FontWeight="SemiBold" Text="{Binding ToolkitUpdatesCountText}" />
                                        </Border>
                                        <Border MinWidth="120" Margin="0,0,8,8" Style="{StaticResource BlockedPillStyle}">
                                            <TextBlock Style="{StaticResource StatusPillTextStyle}" Foreground="#FF991B1B" FontWeight="SemiBold" Text="{Binding ToolkitFailedCountText}" />
                                        </Border>
                                        <Border MinWidth="120" Margin="0,0,8,8" Style="{StaticResource PartialPillStyle}">
                                            <TextBlock Style="{StaticResource StatusPillTextStyle}" Foreground="#FF7C3315" FontWeight="SemiBold" Text="{Binding ToolkitManualCountText}" />
                                        </Border>
                                        <Border MinWidth="190" Margin="0,0,8,8" Style="{StaticResource WorkingPillStyle}">
                                            <TextBlock Style="{StaticResource StatusPillTextStyle}" Foreground="#FF174E75" FontWeight="SemiBold" Text="{Binding ToolkitPlaceholderCountText}" />
                                        </Border>
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Grid.Row="0"
                                                 Margin="0,0,12,0"
                                                 Text="{Binding ToolkitSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Search toolkit inventory" />
                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="0"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PanelLabelBrush}"
                                                   Text="Status" />
                                        <ComboBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,0,12,0"
                                                  ItemsSource="{Binding ToolkitFilterOptions}"
                                                  SelectedItem="{Binding SelectedToolkitFilter}"
                                                  Style="{StaticResource ReadableComboBoxStyle}"
                                                  ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}" />
                                        <TextBlock Grid.Column="3"
                                                   Grid.Row="0"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PanelLabelBrush}"
                                                   Text="Category" />
                                        <ComboBox Grid.Column="4"
                                                  Grid.Row="0"
                                                  ItemsSource="{Binding ToolkitCategoryFilterOptions}"
                                                  SelectedItem="{Binding SelectedToolkitCategoryFilter}"
                                                  Style="{StaticResource ReadableComboBoxStyle}"
                                                  ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}" />
                                        <StackPanel Grid.Column="0"
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="5"
                                                    Margin="0,8,0,0"
                                                    Orientation="Horizontal">
                                            <ComboBox Width="160"
                                                      Margin="0,0,8,0"
                                                      ItemsSource="{Binding ToolkitFamilyFilterOptions}"
                                                      SelectedItem="{Binding SelectedToolkitFamilyFilter}"
                                                      Style="{StaticResource ReadableComboBoxStyle}"
                                                      ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}" />
                                            <ComboBox Width="165"
                                                      Margin="0,0,8,0"
                                                      ItemsSource="{Binding ToolkitArchitectureFilterOptions}"
                                                      SelectedItem="{Binding SelectedToolkitArchitectureFilter}"
                                                      Style="{StaticResource ReadableComboBoxStyle}"
                                                      ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}" />
                                            <ComboBox Width="165"
                                                      Margin="0,0,8,0"
                                                      ItemsSource="{Binding ToolkitBootModeFilterOptions}"
                                                      SelectedItem="{Binding SelectedToolkitBootModeFilter}"
                                                      Style="{StaticResource ReadableComboBoxStyle}"
                                                      ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}" />
                                            <ComboBox Width="180"
                                                      ItemsSource="{Binding ToolkitSourceTrustFilterOptions}"
                                                      SelectedItem="{Binding SelectedToolkitSourceTrustFilter}"
                                                      Style="{StaticResource ReadableComboBoxStyle}"
                                                      ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid Height="430"
                                              AutoGenerateColumns="False"
                                              ItemsSource="{Binding ToolkitHealthItems}"
                                              SelectedItem="{Binding SelectedToolkitHealthItem, Mode=TwoWay}"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              MinRowHeight="36"
                                              RowDetailsVisibilityMode="Collapsed">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Tool" Width="1.4*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Tool}"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                                <Border Margin="6,0,0,0"
                                                                        Padding="6,1"
                                                                        VerticalAlignment="Center"
                                                                        Background="#33A6E0FF"
                                                                        BorderBrush="#66A6E0FF"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        ToolTip="{Binding LicenseNote}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding CatalogStatusTag}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding CatalogStatusTag}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding CatalogStatusTag}"
                                                                               FontSize="10"
                                                                               Foreground="#E6F3FF" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding CatalogBadgesDisplay}"
                                                                       FontSize="10"
                                                                       Foreground="#9FB4C9"
                                                                       Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"
                                                                       ToolTip="{Binding RecommendedUse}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CatalogBadgesDisplay}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding SafetyBadgesDisplay}"
                                                                       FontSize="10"
                                                                       Foreground="#B6CFE5"
                                                                       Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"
                                                                       ToolTip="{Binding FreshnessDetailDisplay}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SafetyBadgesDisplay}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Category" Width="0.9*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Category}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Status" Width="1.1*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StatusDisplayUi}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Type" Width="0.8*">
