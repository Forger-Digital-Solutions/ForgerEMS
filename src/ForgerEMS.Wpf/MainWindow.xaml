<Window x:Class="VentoyToolkitSetup.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ForgerEMS"
        Icon="Assets/ForgerEMS.ico"
        Width="1366"
        Height="820"
        MinWidth="1100"
        MinHeight="700"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="0,0,0,12"
                                           FontSize="14"
                                           FontFamily="Bahnschrift SemiCondensed"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PanelLabelBrush}"
                                           Text="{TemplateBinding Header}" />
                                <ContentPresenter ContentSource="Content" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDeepBrush}" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFC56D" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFF59E0B" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FFB7B0A8" />
                    <Setter Property="BorderBrush" Value="#FF9CA3AF" />
                    <Setter Property="Foreground" Value="#FF4B5563" />
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- FooterButtonStyle must appear before SecondaryButtonStyle: StaticResource cannot forward-reference. -->
        <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#CC0B1220" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelTextBrush}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FooterButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="#D90F1724" />
            <Setter Property="BorderBrush" Value="#8867B7E8" />
            <Setter Property="Foreground" Value="#FFE8F0FF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6162436" />
                    <Setter Property="BorderBrush" Value="#FFFFB86B" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC1A2433" />
                    <Setter Property="BorderBrush" Value="#FFFFC56D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DriverHubPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FooterButtonStyle}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FFFFC56D" />
            <Setter Property="BorderBrush" Value="#FFFFD48A" />
            <Setter Property="Foreground" Value="#FF101820" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFD48A" />
                    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
                    <Setter Property="Foreground" Value="#FF0B1220" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFF59E0B" />
                    <Setter Property="BorderBrush" Value="#FFFFC56D" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF9CA3AF" />
                    <Setter Property="BorderBrush" Value="#FF6B7280" />
                    <Setter Property="Foreground" Value="#FF374151" />
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DriverHubSecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#990B1220" />
            <Setter Property="BorderBrush" Value="#665B6B7F" />
        </Style>

        <!-- Compact "⋯" toggle that opens an overflow popup with advanced actions (Copy Link, Add Shortcut to USB).
             Kept off the primary action row so cards stay store-style and uncluttered. -->
        <Style x:Key="DriverHubOverflowToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#660B1220" />
            <Setter Property="BorderBrush" Value="#665B6B7F" />
            <Setter Property="Foreground" Value="#FFE7EDF8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="OverflowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OverflowBorder" Property="Background" Value="#CC182434" />
                                <Setter TargetName="OverflowBorder" Property="BorderBrush" Value="#88A1C8F0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OverflowBorder" Property="Background" Value="#CC1B2A3E" />
                                <Setter TargetName="OverflowBorder" Property="BorderBrush" Value="#FFFFC56D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DriverHubOverflowMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE7EDF8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFC56D" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="#FFF4F1EA" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="CaretBrush" Value="#FF111111" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#FFD7B18E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#FFF4F1EA" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF152535" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FF111111" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFFFB86B" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF111111" />
            </Style.Resources>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#FFF4F1EA" />
            <Setter Property="Foreground" Value="#FF111111" />
        </Style>

        <!-- Closed state uses light surface + dark text so selection is never white-on-white (ToggleButton default was overriding). -->
        <Style x:Key="ReadableComboBoxStyle" TargetType="ComboBox">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF152535" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE8F0FF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFFFB86B" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF111111" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FF0F1720" />
            </Style.Resources>
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="BorderBrush" Value="#FFD7B18E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7,10,7" />
            <Setter Property="Background" Value="#FFFDF8F3" />
            <Setter Property="Foreground" Value="#FF0F1720" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="MainBorder"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ToggleButton x:Name="ToggleButton"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Path Grid.Column="1"
                                      Data="M0,1.5 L5,6.5 L10,1.5"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.35"
                                      Stretch="Uniform"
                                      Width="11"
                                      Height="7"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="Transparent" />
                            </Grid>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=MainBorder}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=MainBorder}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Padding="2,4"
                                        Background="#FF152535"
                                        BorderBrush="#FFD7B18E"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="ToggleButton" Property="IsEnabled" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadableComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE8F0FF" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E6FFB86B" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6FFB86B" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="Foreground" Value="#FFB8C8DA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UsbTargetComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#F4F1EA" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFDFBF7" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FF111111" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFFFE7C2" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF111111" />
            </Style.Resources>
        </Style>

        <Style x:Key="KyraChatInputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#E6081018" />
            <Setter Property="Foreground" Value="#FFF4F8FF" />
            <Setter Property="BorderBrush" Value="#8867B7E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CaretBrush" Value="#FFFFDAB8" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFB86B" />
                    <Setter Property="Background" Value="#F0101824" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CopilotChatScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="KyraQuickActionChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#CC111A26" />
            <Setter Property="BorderBrush" Value="#665A7AA0" />
            <Setter Property="Foreground" Value="#FFE7EDF8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D9182434" />
                    <Setter Property="BorderBrush" Value="#88A1C8F0" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC1B2A3E" />
                    <Setter Property="BorderBrush" Value="#99A1C8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KyraMessageCopyButtonStyle" TargetType="Button" BasedOn="{StaticResource FooterButtonStyle}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Background" Value="#AA111A26" />
            <Setter Property="BorderBrush" Value="#555A7AA0" />
            <Setter Property="Foreground" Value="#FFD5DFEE" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="KyraMessageDetailsExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource PanelMutedTextBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="DiagnosticsStatusChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF4F8FF" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DiagnosticsStatusChipBaseStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#D90A101A" />
            <Setter Property="BorderBrush" Value="#AA67B7E8" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="DiagnosticsStatusChipReadyStyle" TargetType="Border" BasedOn="{StaticResource DiagnosticsStatusChipBaseStyle}">
            <Setter Property="Background" Value="#D9071818" />
            <Setter Property="BorderBrush" Value="#DD22D3A6" />
        </Style>

        <Style x:Key="DiagnosticsStatusChipWarningStyle" TargetType="Border" BasedOn="{StaticResource DiagnosticsStatusChipBaseStyle}">
            <Setter Property="Background" Value="#D91D1306" />
            <Setter Property="BorderBrush" Value="#FFF59E0B" />
        </Style>

        <Style x:Key="DiagnosticsStatusChipProblemStyle" TargetType="Border" BasedOn="{StaticResource DiagnosticsStatusChipBaseStyle}">
            <Setter Property="Background" Value="#D91C0B08" />
            <Setter Property="BorderBrush" Value="#FFFF6B4A" />
        </Style>

        <Style x:Key="DiagnosticsStatusChipNeutralStyle" TargetType="Border" BasedOn="{StaticResource DiagnosticsStatusChipBaseStyle}">
            <Setter Property="Background" Value="#D90A1422" />
            <Setter Property="BorderBrush" Value="#CC67B7E8" />
        </Style>

        <Style x:Key="DiagnosticsExpanderHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#FFF4F8FF" />
            <Setter Property="Background" Value="#E60A101A" />
            <Setter Property="BorderBrush" Value="#AA67B7E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Chevron"
                                      Grid.Column="0"
                                      Width="9"
                                      Height="9"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 6 4.5 L 0 9 Z"
                                      Fill="#FFFFC58F"
                                      Stretch="Uniform"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="4,0,0,0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#F0101824" />
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#FFFFC58F" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#FF67E8F9" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#FFFFC58F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiagnosticsExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="#FFF4F8FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <ToggleButton DockPanel.Dock="Top"
                                          Style="{StaticResource DiagnosticsExpanderHeaderToggleStyle}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="ExpandSite"
                                    Margin="0,6,0,0"
                                    Padding="12"
                                    Background="#CC07111D"
                                    BorderBrush="#665A7AA0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                <ContentPresenter ContentSource="Content" />
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PanelTextBrush}" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TabStripPlacement" Value="Left" />
        </Style>

        <Style x:Key="ContentOnlyTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          KeyboardNavigation.TabNavigation="Local"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#CC0A101A" />
            <Setter Property="BorderBrush" Value="#6657C7E8" />
            <Setter Property="Foreground" Value="#FFD7DEE8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionTileButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#FFFFE7C2" />
            <Setter Property="BorderBrush" Value="#FFFFB86B" />
            <Setter Property="Foreground" Value="#FF111111" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFD7DEE8" />
            <Setter Property="Background" Value="#B80A101A" />
            <Setter Property="BorderBrush" Value="#6657C7E8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,16,12" />
            <Setter Property="Width" Value="232" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter Margin="10,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True"
                                                  ContentSource="Header" />
                                <Border x:Name="ActiveLine"
                                        Width="4"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        CornerRadius="2" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF243447" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FFFFC56D" />
                                <Setter TargetName="ActiveLine" Property="Background" Value="#FFFFB86B" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#CC67E8F9" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F4F1EA" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="BorderBrush" Value="#FFD7B18E" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowBackground" Value="#FFFDFBF7" />
            <Setter Property="AlternatingRowBackground" Value="#FFFFF7ED" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="Background" Value="#FFFDFBF7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="INSTALLED">
                    <Setter Property="Background" Value="#FFE8FAEF" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="MISSING_REQUIRED">
                    <Setter Property="Background" Value="#FFFFE4E6" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="HASH_FAILED">
                    <Setter Property="Background" Value="#FFFFCDD2" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="MANUAL_REQUIRED">
                    <Setter Property="Background" Value="#FFEFF6FF" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PLACEHOLDER">
                    <Setter Property="Background" Value="#FFEFF6FF" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="COVERED_BY_MANAGED">
                    <Setter Property="Background" Value="#FFE8FAEF" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="UPDATE_AVAILABLE">
                    <Setter Property="Background" Value="#FFFFF7ED" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFFFE7C2" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UsbTargetComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#FFF4F1EA" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FFE2C7AC" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFFFE7C2" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="Foreground" Value="#FF4B5563" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#000000"
          ClipToBounds="True"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Image x:Name="CommandCenterBackgroundImage"
               Panel.ZIndex="1"
               Source="Assets/ForgerEMS_CommandCenterBackground.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Opacity="1"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="Fant"
               CacheMode="BitmapCache" />

        <Rectangle x:Name="BackgroundReadabilityVeil"
                   Panel.ZIndex="3"
                   Opacity="0.62"
                   IsHitTestVisible="False"
                   CacheMode="BitmapCache">
            <Rectangle.Fill>
                <SolidColorBrush Color="#FF05070A" />
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="16" Panel.ZIndex="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,6"
                Padding="10,6"
                MinHeight="0"
                Background="#E6090F18"
                BorderBrush="#FF394659"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Border Width="32"
                                Height="32"
                                Margin="0,0,8,0"
                                VerticalAlignment="Top"
                                Background="#FF111827"
                                BorderBrush="#FFCF8C5C"
                                BorderThickness="1.2"
                                CornerRadius="7">
                            <Image Margin="3"
                                   Source="Assets/ForgerEMS_Icon.png"
                                   Stretch="Uniform" />
                        </Border>

                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontFamily="Bahnschrift SemiCondensed"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HeroTextBrush}"
                                   Text="ForgerEMS"
                                   TextWrapping="NoWrap" />

                        <TextBlock Margin="0,1,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFD7DEE8"
                                   Text="{Binding SelectedItem.Header, ElementName=MainTabControl, TargetNullValue=USB Builder}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>

                    <StackPanel x:Name="HeaderLeftSupportCopyGroup"
                                Margin="0,1,12,0"
                                HorizontalAlignment="Left">
                        <TextBlock FontSize="10.5"
                                   Foreground="#FFE8F0FF"
                                   LineHeight="12"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap">
                            <Run FontWeight="SemiBold" Text="Beta issue? Send logs/screenshots to " />
                            <Hyperlink NavigateUri="{Binding SupportMailtoUri, Mode=OneWay}"
                                       RequestNavigate="SupportMailto_OnRequestNavigate"
                                       Foreground="#FFFFDAB8"
                                       TextDecorations="Underline">
                                <Run FontWeight="Bold"
                                     Foreground="#FFFFDAB8"
                                     Text="{Binding SupportEmailAddress, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,1,0,0"
                                   FontSize="10"
                                   Foreground="#99B8CCE8"
                                   LineHeight="11"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Text="{Binding SupportEmailDoNotSecretsText, Mode=OneWay}" />
                        <TextBlock Margin="0,1,0,0"
                                   FontSize="10.5"
                                   Foreground="#CCF0F7FF"
                                   FontStyle="Italic"
                                   LineHeight="12"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Text="{Binding PublicPreviewBannerText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="HeaderRightStatusGrid"
                      Grid.Column="1"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      MaxWidth="430">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Border Margin="0,0,12,0"
                                Style="{StaticResource StatusPillBorderStyle}"
                                VerticalAlignment="Center"
                                Background="{Binding StatusBackground}"
                                BorderBrush="{Binding StatusBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Style="{StaticResource StatusPillTextStyle}"
                                       FontWeight="Bold"
                                       Foreground="{Binding StatusForeground}"
                                       Text="{Binding CurrentTaskState}"
                                       TextWrapping="NoWrap" />
                        </Border>

                        <TextBlock Margin="0,0,14,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFE0E8F4"
                                   Text="{Binding HeaderUsbTargetText}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />

                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFD9B392"
                                   Text="{Binding AppVersionText}"
                                   TextWrapping="NoWrap" />
                    </StackPanel>

                    <Border x:Name="NetworkPulseHeaderCompactIsland"
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            MaxWidth="420"
                            Visibility="{Binding NetworkPulse.HeaderWidgetVisibility}"
                            Background="#33101824"
                            BorderBrush="#55394659"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5,2">
                        <Grid>
                            <Button x:Name="NetworkPulseFlyoutTarget"
                                    HorizontalContentAlignment="Stretch"
                                    HorizontalAlignment="Stretch"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding NetworkPulse.ToggleDetailsCommand}"
                                    ToolTip="{Binding NetworkPulse.HeaderToolTip}">
                                <StackPanel>
                                    <TextBlock Text="{Binding NetworkPulse.InternetWidgetLine1}"
                                               Foreground="{Binding NetworkPulse.HeaderStatusBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LineHeight="13"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Margin="0,1,0,0"
                                               Text="{Binding NetworkPulse.InternetWidgetLine2}"
                                               Foreground="#FFC9D8EE"
                                               FontSize="10.25"
                                               LineHeight="12"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Margin="0,1,0,0"
                                               Text="{Binding NetworkPulse.InternetWidgetLine3}"
                                               Foreground="#99B8CCE8"
                                               FontSize="9.75"
                                               LineHeight="11"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        <Popup PlacementTarget="{Binding ElementName=NetworkPulseFlyoutTarget}"
                               IsOpen="{Binding NetworkPulse.IsDetailsOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               Placement="Bottom">
                            <Border MinWidth="300"
                                    MaxWidth="460"
                                    Padding="12,10"
                                    Background="#F0101824"
                                    BorderBrush="#FF394659"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource HeroTextBrush}"
                                               Text="Network Pulse" />

                                    <!-- SECTION: Connectivity -->
                                    <TextBlock Margin="0,10,0,4"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="#FF9BD0F0"
                                               Text="CONNECTIVITY" />
                                    <TextBlock FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Adapter" />
                                    <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                               Text="{Binding NetworkPulse.DetailAdapterText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Connection" />
                                    <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                               Text="{Binding NetworkPulse.DetailConnectionText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Wi-Fi context"
                                               Visibility="{Binding NetworkPulse.DetailWifiVisibility}" />
                                    <TextBlock Foreground="{DynamicResource PanelMutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding NetworkPulse.DetailWifiContextText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding NetworkPulse.DetailWifiVisibility}" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Download" />
                                    <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                               Text="{Binding NetworkPulse.DetailDownloadText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Upload" />
                                    <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                               Text="{Binding NetworkPulse.DetailUploadText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Ping" />
                                    <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                               Text="{Binding NetworkPulse.DetailPingText}"
                                               TextWrapping="Wrap" />

                                    <!-- SECTION: Stability -->
                                    <TextBlock Margin="0,12,0,4"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="#FF9BD0F0"
                                               Text="STABILITY" />
                                    <TextBlock FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Reliability" />
                                    <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                               Text="{Binding NetworkPulse.DetailReliabilityTierText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding NetworkPulse.DetailReliabilityExplainText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Jitter" />
                                    <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                               Text="{Binding NetworkPulse.DetailJitterText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Packet loss" />
                                    <TextBlock Foreground="{DynamicResource PanelTextBrush}"
                                               Text="{Binding NetworkPulse.DetailLossText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Recent ping (relative)"
                                               Visibility="{Binding NetworkPulse.DetailSparklineVisibility}" />
                                    <Border Height="28"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Left"
                                            Width="132"
                                            Background="Transparent"
                                            SnapsToDevicePixels="True"
                                            Visibility="{Binding NetworkPulse.DetailSparklineVisibility}">
                                        <Path Data="{Binding NetworkPulse.PingSparklineGeometry}"
                                              Stroke="#809BB8D8"
                                              StrokeThickness="1.25"
                                              StrokeLineJoin="Round"
                                              Stretch="Fill" />
                                    </Border>

                                    <!-- SECTION: Diagnostics (lower emphasis) -->
                                    <TextBlock Margin="0,12,0,4"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="#FF7C9CB8"
                                               Text="DIAGNOSTICS" />
                                    <TextBlock FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Gateway / DNS samples" />
                                    <TextBlock Foreground="{DynamicResource PanelMutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding NetworkPulse.DetailGatewayText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding NetworkPulse.DetailDnsText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Status / confidence" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock Foreground="{DynamicResource PanelMutedTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding NetworkPulse.DetailStatusText}" />
                                        <TextBlock Foreground="{DynamicResource PanelMutedTextBrush}"
                                                   FontSize="11"
                                                   Text=" · " />
                                        <TextBlock Foreground="{DynamicResource PanelMutedTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding NetworkPulse.DetailConfidenceText}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Last checked" />
                                    <TextBlock Foreground="{DynamicResource PanelMutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding NetworkPulse.DetailLastCheckedText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Adapter link (estimated ceiling)" />
                                    <TextBlock Foreground="{DynamicResource PanelMutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding NetworkPulse.DetailLinkCeilingText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Visibility="{Binding NetworkPulse.DetailPauseReasonVisibility}"
                                               FontSize="11"
                                               Foreground="#FFFFE8CC"
                                               Text="{Binding NetworkPulse.DetailPauseReasonText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Data sources" />
                                    <TextBlock Foreground="{DynamicResource PanelMutedTextBrush}"
                                               FontSize="10.5"
                                               Text="{Binding NetworkPulse.DetailDataNotesText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               FontSize="10.5"
                                               Text="{Binding NetworkPulse.DetailSmoothingNoteText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="Safety" />
                                    <TextBlock Foreground="{DynamicResource PanelMutedTextBrush}"
                                               FontSize="10.5"
                                               Text="{Binding NetworkPulse.DetailSafetyNotesText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,10"
                Visibility="{Binding AppUpdateBannerVisibility}"
                Background="#1A0F1724"
                BorderBrush="#FFFFB86B"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontWeight="Bold"
                           FontSize="13"
                           Foreground="#FFFFE8CC"
                           TextWrapping="Wrap"
                           Text="{Binding AppUpdateBannerTitle}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="11.5"
                           Foreground="#FFE8F0FF"
                           TextWrapping="Wrap"
                           Text="{Binding AppUpdateBannerDetail}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="10.5"
                           Foreground="#99B8CCE8"
                           TextWrapping="Wrap"
                           Text="{Binding AppUpdateStateDisplay}" />
                <WrapPanel Margin="0,10,0,0">
                    <Button MinWidth="118"
                            Margin="0,0,8,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Retry check"
                            Command="{Binding CheckForUpdatesNowCommand}"
                            Visibility="{Binding AppUpdateDiagnosticsHintVisibility}" />
                    <Button MinWidth="128"
                            Margin="0,0,8,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="View logs"
                            Command="{Binding OpenLogsFolderCommand}"
                            Visibility="{Binding AppUpdateDiagnosticsHintVisibility}" />
                    <Button MinWidth="168"
                            Margin="0,0,8,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Open GitHub Release"
                            Command="{Binding AppUpdateViewReleaseNotesCommand}"
                            Visibility="{Binding AppUpdateViewReleaseNotesVisibility}" />
                    <Button MinWidth="168"
                            Margin="0,0,8,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Copy ZIP download link"
                            Command="{Binding CopyUpdateZipLinkCommand}"
                            Visibility="{Binding AppUpdateCopyZipLinkVisibility}" />
                    <Button MinWidth="200"
                            Margin="0,0,8,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Copy checksum instructions"
                            Command="{Binding CopyUpdateChecksumInstructionsCommand}"
                            Visibility="{Binding AppUpdateCopyChecksumInstructionsVisibility}" />
                    <Button MinWidth="198"
                            Margin="0,0,8,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Download recommended (ZIP/EXE)"
                            Command="{Binding AppUpdateDownloadInstallerCommand}"
                            Visibility="{Binding AppUpdateDownloadButtonVisibility}" />
                    <Button MinWidth="210"
                            Margin="0,0,8,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Download installer (Advanced)"
                            Command="{Binding AppUpdateDownloadAdvancedInstallerCommand}"
                            Visibility="{Binding AppUpdateAdvancedDownloadButtonVisibility}" />
                    <Button MinWidth="118"
                            Margin="0,0,8,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Remind me later"
                            Command="{Binding AppUpdateRemindLaterCommand}" />
                    <Button MinWidth="124"
                            Margin="0,0,8,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Ignore this version"
                            Command="{Binding AppUpdateIgnoreVersionCommand}"
                            Visibility="{Binding AppUpdateIgnoreButtonVisibility}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" MinWidth="640" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Button x:Name="NavUsbButton" Style="{StaticResource SidebarNavButtonStyle}" Tag="0" Click="OnSidebarNavigateClick" Content="▣  USB Builder" />
                    <Button x:Name="NavSystemButton" Style="{StaticResource SidebarNavButtonStyle}" Tag="1" Click="OnSidebarNavigateClick" Content="◎  System Intelligence" />
                    <Button x:Name="NavToolkitButton" Style="{StaticResource SidebarNavButtonStyle}" Tag="2" Click="OnSidebarNavigateClick" Content="▤  Toolkit Manager" />
                    <Button x:Name="NavDriverHubButton" Style="{StaticResource SidebarNavButtonStyle}" Tag="3" Click="OnSidebarNavigateClick" Content="▥  Driver Hub" />
                    <Button x:Name="NavCopilotButton" Style="{StaticResource SidebarNavButtonStyle}" Tag="4" Click="OnSidebarNavigateClick" Content="◇  Kyra (Beta)" />
                    <Button x:Name="NavDiagnosticsButton" Style="{StaticResource SidebarNavButtonStyle}" Tag="5" Click="OnSidebarNavigateClick" Content="⚙  Diagnostics" />
                    <Button x:Name="NavSettingsButton" Style="{StaticResource SidebarNavButtonStyle}" Tag="6" Click="OnSidebarNavigateClick" Content="☰  Settings" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="12"
                        VerticalAlignment="Stretch"
                        Background="#DC090F18"
                        BorderBrush="#8867B7E8"
                        BorderThickness="1"
                        CornerRadius="10">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="0,0,0,8"
                                   FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFDAB8"
                                   Text="Live Logs" />

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Margin="0,0,0,8"
                                    Padding="10,7"
                                    MinHeight="34"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="View Full Logs"
                                    Click="OnShowFullLogsClick" />
                            <TextBlock FontSize="10.5"
                                       Foreground="#8899AABB"
                                       Text="© 2026 Forger Digital Solutions"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="10.5"
                                       Foreground="#8899AABB"
                                       Text="Beta issue? ForgerDigitalSolutions@outlook.com"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="10.5"
                                       Foreground="#8899AABB"
                                       Text="No API keys/passwords/private documents."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FFE0E8F4"
                                       Text="{Binding LogStatusLineText}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,0,0,8"
                                    Padding="8"
                                    Visibility="{Binding ProgressVisibility}"
                                    Background="#B80A101A"
                                    BorderBrush="#6657C7E8"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <ProgressBar Height="8"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding CurrentProgressValue, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                                    <UniformGrid Margin="0,7,0,0" Columns="2">
                                        <TextBlock FontSize="10.5" Foreground="#FFE0E8F4" Text="{Binding UsbProgressStageText}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="10.5" Foreground="#FFE0E8F4" Text="{Binding UsbProgressItemText}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="10.5" Foreground="#FFE0E8F4" Text="{Binding UsbProgressPercentText}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="10.5" Foreground="#FFE0E8F4" Text="{Binding UsbProgressTransferText}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="10.5" Foreground="#FFE0E8F4" Text="{Binding UsbProgressSpeedText}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="10.5" Foreground="#FFD9B392" Text="{Binding UsbProgressHeartbeatText}" TextWrapping="Wrap" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border MinHeight="120"
                                    Padding="8"
                                    Background="#E6050911"
                                    BorderBrush="#4457C7E8"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="220">
                                    <TextBlock FontFamily="Consolas"
                                               FontSize="10.5"
                                               Foreground="#FFC9D7EA"
                                               Text="{Binding RecentLogsText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <ScrollViewer x:Name="MainContentScrollViewer"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PreviewMouseWheel="OnMainContentPreviewMouseWheel">
                <TabControl x:Name="MainTabControl"
                            Style="{StaticResource ContentOnlyTabControlStyle}"
                            Margin="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            SelectionChanged="OnMainTabSelectionChanged">
                    <TabItem Header="▣  USB Builder">
                        <StackPanel Margin="24,0,24,0" MaxWidth="1040" HorizontalAlignment="Left">
                    <GroupBox Header="USB Target / Drive Details">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,5"
                                       FontSize="12"
                                       FontFamily="Bahnschrift SemiCondensed"
                                   FontWeight="SemiBold"
                                       Foreground="{DynamicResource PanelLabelBrush}"
                                       Text="Owner / Bench Name" />
                            <TextBox Margin="0,0,0,12"
                                     Text="{Binding UsbOwnerName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Defaults to this PC name"
                                     IsEnabled="{Binding IsIdle}" />
                            <TextBlock Margin="0,-8,0,12"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SlateTextBrush}"
                                       Text="Defaults to this PC name"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,2,0,6"
                                       FontSize="12"
                                       FontFamily="Bahnschrift SemiCondensed"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PanelLabelBrush}"
                                       Text="USB Target" />
                            <Border Margin="0,0,0,10"
                                    Padding="10,8"
                                    Background="#E8F4FC"
                                    BorderBrush="#FF93C5FD"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FF0F172A"
                                           Text="{Binding UsbBuilderTargetStatusBanner}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding UsbTargets}"
                                          SelectedItem="{Binding SelectedUsbTarget}"
                                          IsEnabled="{Binding IsIdle}"
                                          Style="{StaticResource UsbTargetComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource UsbTargetComboItemStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="#FF111111"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11.5"
                                                           Foreground="#FF4B5563"
                                                           Text="{Binding SelectionWarningDisplay}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Padding="12,8"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Refresh USB Targets"
                                        Command="{Binding RefreshUsbTargetsCommand}" />
                            </Grid>

                            <TextBlock Margin="0,4,0,8"
                                       FontSize="12"
                                       FontFamily="Bahnschrift SemiCondensed"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PanelLabelBrush}"
                                       Text="Drive Details" />

                            <Grid Margin="0,0,0,12" Grid.IsSharedSizeScope="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TargetLabel" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Drive" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.RootPath, TargetNullValue=No USB selected — choose a target above.}" />

                                <TextBlock Grid.Row="1" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Label" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.LabelDisplay, TargetNullValue=—}" />

                                <TextBlock Grid.Row="2" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Capacity" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.DisplayTotalBytes, TargetNullValue=—}" />

                                <TextBlock Grid.Row="3" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Free space" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.DisplayFreeBytes, TargetNullValue=—}" />

                                <TextBlock Grid.Row="4" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="File system" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.FileSystem, TargetNullValue=—}" />

                                <TextBlock Grid.Row="5" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Safety" />
                                <TextBlock Grid.Row="5" Grid.Column="1" FontWeight="Bold" Foreground="{Binding TargetWarningForeground}" Text="{Binding SelectedUsbTarget.SafetyStatusText, TargetNullValue=—}" />

                                <TextBlock Grid.Row="6" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Reason" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.SafetyReasonText, TargetNullValue=—}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="7" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Drive type" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.SelectionStatusText, TargetNullValue=—}" />

                                <TextBlock Grid.Row="8" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Bus type" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.BusTypeDisplay, TargetNullValue=—}" />

                                <TextBlock Grid.Row="9" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Device" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.DeviceIdentityDisplay, TargetNullValue=—}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="10" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Read speed" />
                                <TextBlock Grid.Row="10" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.ReadSpeedDisplayNormalized, TargetNullValue=Not benchmarked}" />

                                <TextBlock Grid.Row="11" Margin="0,0,14,0" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Write speed" />
                                <TextBlock Grid.Row="11" Grid.Column="1" Margin="0,0,0,8" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.WriteSpeedDisplayNormalized, TargetNullValue=Not benchmarked}" />

                                <TextBlock Grid.Row="12" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Benchmark" />
                                <TextBlock Grid.Row="12" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.BenchmarkStatusDisplay, TargetNullValue=Queued}" />
                                <TextBlock Grid.Row="13" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Benchmark summary" />
                                <TextBlock Grid.Row="13" Grid.Column="1" Margin="0,0,0,8" Foreground="{DynamicResource PanelMutedTextBrush}" Text="{Binding SelectedUsbTarget.BenchmarkUiSummaryLine, TargetNullValue=—}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="14" Margin="0,0,14,8" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Test size" />
                                <TextBlock Grid.Row="14" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.BenchmarkTestSizeDisplay, TargetNullValue=Not tested}" />

                                <TextBlock Grid.Row="15" Margin="0,0,14,0" FontWeight="SemiBold" Foreground="{DynamicResource PanelLabelBrush}" Text="Last tested" />
                                <TextBlock Grid.Row="15" Grid.Column="1" Foreground="{DynamicResource PanelTextBrush}" Text="{Binding SelectedUsbTarget.BenchmarkLastTestedDisplay, TargetNullValue=Never}" />
                            </Grid>

                            <Border Padding="12"
                                    Background="{Binding TargetWarningBackground}"
                                    BorderBrush="{Binding TargetWarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TextBlock FontSize="12"
                                           Foreground="{Binding TargetWarningForeground}"
                                           Text="{Binding TargetWarningText}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="USB Builder Profile">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10"
                                       FontSize="12"
                                       Foreground="{DynamicResource PanelTextBrush}"
                                       Text="Choose what this USB includes"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding UsbBuilderProfileOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="318"
                                                MinHeight="118"
                                                Margin="0,0,10,10"
                                                Padding="12"
                                                Background="#B80A101A"
                                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ToolTip="{Binding DetailTooltipText}">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanToggle}">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PanelLabelBrush}"
                                                               Text="{Binding DisplayName}"
                                                               TextWrapping="Wrap" />
                                                </CheckBox>
                                                <TextBlock Margin="22,4,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PanelMutedTextBrush}"
                                                           Text="{Binding ShortDescription}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="34"
                                                           TextWrapping="Wrap" />
                                                <WrapPanel Margin="22,8,0,0">
                                                    <Border Margin="0,0,6,4"
                                                            Padding="6,2"
                                                            Background="#332563EB"
                                                            BorderBrush="#FF3B82F6"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <TextBlock FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FF93C5FD"
                                                                   Text="{Binding StatusChipText}" />
                                                    </Border>
                                                    <Border Margin="0,0,6,4"
                                                            Padding="6,2"
                                                            Background="#33165F46"
                                                            BorderBrush="#FF22C55E"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <TextBlock FontSize="10"
                                                                   Foreground="#FF86EFAC"
                                                                   Text="{Binding SpaceChipText}" />
                                                    </Border>
                                                    <Border Margin="0,0,6,4"
                                                            Padding="6,2"
                                                            Background="#33451A03"
                                                            BorderBrush="#FFF59E0B"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <TextBlock FontSize="10"
                                                                   Foreground="#FFFCD34D"
                                                                   Text="{Binding AcquisitionChipText}" />
                                                    </Border>
                                                    <Border Margin="0,0,6,4"
                                                            Padding="6,2"
                                                            Background="#3322362F"
                                                            BorderBrush="#FF64748B"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Visibility="{Binding HasDetectedMediaChip, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock FontSize="10"
                                                                   Foreground="#FFCBD5E1"
                                                                   Text="{Binding DetectedMediaChipText}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Margin="22,2,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource PanelMutedTextBrush}"
                                                           Text="{Binding Platform}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,0,0,8">
                                <Button Margin="0,0,8,4"
                                        Padding="10,6"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Select recommended"
                                        Command="{Binding SelectRecommendedUsbBuilderProfileCommand}" />
                                <Button Margin="0,0,8,4"
                                        Padding="10,6"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Select all"
                                        Command="{Binding SelectAllUsbBuilderProfileCommand}" />
                                <Button Margin="0,0,8,4"
                                        Padding="10,6"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Reset to defaults"
                                        Command="{Binding ResetUsbBuilderProfileCommand}" />
                                <Button x:Name="UsbBuilderProfileFullManagedDownloadButton"
                                        Margin="0,0,8,4"
                                        Padding="10,6"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Full Managed Download"
                                        ToolTip="Download/update all safe managed tools for this USB profile. Manual/vendor links remain guided shortcuts."
                                        Command="{Binding FullManagedDownloadCommand}" />
                            </WrapPanel>

                            <Border Margin="0,0,0,8"
                                    Padding="10"
                                    Background="#142A3A"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel>
                                    <TextBlock x:Name="UsbBuilderProfileFullManagedDownloadStatusText"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PanelLabelBrush}"
                                               Text="{Binding FullManagedDownloadStatusText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource PanelMutedTextBrush}"
                                               Text="{Binding FullManagedDownloadDetailText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Padding="12"
                                    Background="#E8F4FC"
                                    BorderBrush="#FF93C5FD"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FF0F172A"
                                               Text="{Binding UsbBuilderProfileSummaryText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="11.5"
                                               Foreground="#FF334155"
                                               Text="{Binding UsbBuilderProfileNoteText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!--
                        Port Intelligence summary card. Heavy actions (Run USB Benchmark,
                        port mapping capture/detect/save, legacy advanced expander)
                        intentionally stay in the USB Mapping Wizard. ViewModel benchmark,
                        mapping, and charging telemetry commands remain available so
                        wizards and tests can still reach them.
                    -->
                    <GroupBox x:Name="UsbBuilderUsbIntelligenceCompactCard" Header="Port Intelligence">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PanelTextBrush}"
                                       Text="Port Intelligence"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,10"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                       Text="Map USB devices, ports, hubs, charging state, power confidence, and common bottlenecks using safe Windows telemetry."
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource PanelMutedTextBrush}"
                                           Text="{Binding UsbIntelligenceProPreviewBadge}"
                                           TextWrapping="Wrap" />
                                <Border Grid.Column="1"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="#33334155"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PanelTextBrush}">
                                        <Run Text="Confidence: " />
                                        <Run Text="{Binding UsbIntelligenceConfidenceScoreDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </Grid>
