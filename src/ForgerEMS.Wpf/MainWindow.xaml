                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,6"
                                                           Foreground="{DynamicResource PanelTextBrush}"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Margin="0,10,0,0" Padding="10" Background="#B80A101A" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding SystemIntelligenceReportPathText}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="{Binding SystemIntelligenceReportSafePathText}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PanelMutedTextBrush}"
                                                       Text="Use Open Files above for JSON, Markdown, and the reports folder."
                                                       TextWrapping="Wrap" />
