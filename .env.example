# ForgerEMS local environment example.
# Copy to .env only for your own local shell tooling if needed.
# The app does not require this file, and real .env files are ignored by git.

# Deep Sensor Mode
FORGEREMS_DEEP_SENSOR_MODE=Off
# FORGEREMS_DEEP_SENSOR_MODE=ReadOnly

# Core app/testing hints
# FORGEREMS_ENV=Development
# FORGEREMS_RELEASE_CHANNEL=preview
# FORGEREMS_LOG_LEVEL=Info
# FORGEREMS_VERBOSE_LIVE_LOGS=false

# GitHub update checker overrides
# FORGEREMS_GITHUB_OWNER=Forger-Digital-Solutions
# FORGEREMS_GITHUB_REPO=ForgerEMS
# FORGEREMS_UPDATE_USER_AGENT=ForgerEMS

# Kyra / AI provider examples — placeholders only.
# Offline/local mode works without any API key.
# FORGEREMS_KYRA_PROVIDER=offline
# FORGEREMS_KYRA_ONLINE_ENABLED=false
# FORGEREMS_KYRA_SHARE_SYSTEM_CONTEXT=false

# OpenAI-compatible provider examples
# FORGEREMS_OPENAI_BASE_URL=https://api.openai.com/v1
# FORGEREMS_OPENAI_MODEL=gpt-4.1-mini
# FORGEREMS_OPENAI_API_KEY=REPLACE_ME
# OPENAI_API_KEY=REPLACE_ME

# Local AI examples
# FORGEREMS_OLLAMA_BASE_URL=http://localhost:11434
# FORGEREMS_OLLAMA_MODEL=llama3.1
# FORGEREMS_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# FORGEREMS_LMSTUDIO_MODEL=local-model-name
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Optional cloud provider examples
# GEMINI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME
# GROQ_API_KEY=REPLACE_ME
# OPENROUTER_API_KEY=REPLACE_ME
# CEREBRAS_API_KEY=REPLACE_ME
# MISTRAL_API_KEY=REPLACE_ME
# GITHUB_MODELS_TOKEN=REPLACE_ME
# CLOUDFLARE_API_KEY=REPLACE_ME
# CLOUDFLARE_ACCOUNT_ID=REPLACE_ME

# Marketplace / valuation future placeholders
# FORGEREMS_MARKETPLACE_ENABLED=false
# FORGEREMS_EBAY_ENABLED=false
# FORGEREMS_EBAY_APP_ID=REPLACE_ME
# FORGEREMS_EBAY_CERT_ID=REPLACE_ME
# FORGEREMS_EBAY_DEV_ID=REPLACE_ME
# FORGEREMS_MARKETPLACE_REGION=US
# FORGEREMS_VALUATION_MODE=offline

# Diagnostics and local preview
# FORGEREMS_DIAGNOSTICS_EXPORT_DIR=C:\Path\To\Local\Exports
# FORGEREMS_ENABLE_DIAGNOSTIC_BUNDLE=true
# FORGEREMS_LICENSE_TIER=PublicPreview
