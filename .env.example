# ForgerEMS local environment example.
# Copy to .env only for your own local shell tooling if needed.
# The app does not require this file, and real .env files are ignored by git.

# Deep Sensor Mode
FORGEREMS_DEEP_SENSOR_MODE=Off
# FORGEREMS_DEEP_SENSOR_MODE=ReadOnly

# Core app/testing hints
# FORGEREMS_ENV=Development
# FORGEREMS_RELEASE_CHANNEL=preview
# FORGEREMS_LOG_LEVEL=Info
# FORGEREMS_VERBOSE_LIVE_LOGS=false

# GitHub update checker overrides
# FORGEREMS_GITHUB_OWNER=Forger-Digital-Solutions
# FORGEREMS_GITHUB_REPO=ForgerEMS
# FORGEREMS_UPDATE_USER_AGENT=ForgerEMS

# Kyra / AI provider examples — placeholders only.
# Offline/local mode works without any API key.
# Placeholder values such as REPLACE_ME, YOUR_*, PASTE_*, local-model-name,
# model-name, sample/example values, example.local, and REPLACE_MODEL_NAME are
# intentionally ignored by Kyra and never make a provider look configured.
# FORGEREMS_KYRA_PROVIDER=offline
# FORGEREMS_KYRA_ONLINE_ENABLED=false
# FORGEREMS_KYRA_SHARE_SYSTEM_CONTEXT=false
# FORGEREMS_KYRA_API_FIRST=true
# FORGEREMS_KYRA_PROVIDER_PRIORITY=forgerems-gateway,openai-compatible,custom,openrouter,groq,gemini,anthropic,mistral,cerebras,github-models,cloudflare,lmstudio,ollama,offline
# FORGEREMS_KYRA_CONSENSUS_MODE=false
# FORGEREMS_KYRA_MEMORY_MODE=session
# FORGEREMS_KYRA_PERSIST_MEMORY=false
# FORGEREMS_KYRA_MAX_CONTEXT_TURNS=100
# FORGEREMS_KYRA_CONTEXT_MAX_CHARS=12000
# FORGEREMS_KYRA_PROVIDER_TIMEOUT_SECONDS=60
# FORGEREMS_KYRA_PERSONALITY=bubbly-tech

# ForgerEMS Beta Gateway examples
# Provider API keys must live only on the gateway/server, never in the desktop app.
# The beta token is a revocable gateway access token, not an OpenAI/OpenRouter/Groq/etc. key.
# FORGEREMS_KYRA_PROVIDER=forgerems-gateway
# FORGEREMS_KYRA_GATEWAY_URL=https://REPLACE_ME.workers.dev
# FORGEREMS_KYRA_GATEWAY_BETA_TOKEN=REPLACE_WITH_BETA_ACCESS_TOKEN
# FORGEREMS_KYRA_GATEWAY_TIMEOUT_SECONDS=60
# FORGEREMS_KYRA_GATEWAY_DAILY_REQUEST_LIMIT=
# FORGEREMS_KYRA_GATEWAY_SHARE_SYSTEM_CONTEXT=false

# OpenAI-compatible provider examples
# FORGEREMS_OPENAI_BASE_URL=https://api.openai.com/v1
# FORGEREMS_OPENAI_MODEL=gpt-4.1-mini
# FORGEREMS_OPENAI_API_KEY=REPLACE_ME
# OPENAI_API_KEY=REPLACE_ME

# Local AI examples
# FORGEREMS_OLLAMA_BASE_URL=http://localhost:11434
# FORGEREMS_OLLAMA_MODEL=llama3.1
# FORGEREMS_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# FORGEREMS_LMSTUDIO_MODEL=local-model-name
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Custom OpenAI-compatible provider examples
# FORGEREMS_CUSTOM_PROVIDER_BASE_URL=https://example.local/v1
# FORGEREMS_CUSTOM_PROVIDER_MODEL=model-name
# FORGEREMS_CUSTOM_PROVIDER_API_KEY=REPLACE_ME

# Optional cloud provider examples
# GEMINI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME
# GROQ_API_KEY=REPLACE_ME
# OPENROUTER_API_KEY=REPLACE_ME
# CEREBRAS_API_KEY=REPLACE_ME
# MISTRAL_API_KEY=REPLACE_ME
# GITHUB_MODELS_TOKEN=REPLACE_ME
# One GitHub Models token can route multiple model IDs; these are model choices, not secrets.
# FORGEREMS_GITHUB_MODELS_DEFAULT_MODEL=openai/gpt-5
# FORGEREMS_GITHUB_MODELS_FAST_MODEL=deepseek/DeepSeek-V3-0324
# FORGEREMS_GITHUB_MODELS_ALT_MODEL=meta/Llama-4-Scout-17B-16E-Instruct
# CLOUDFLARE_API_KEY=REPLACE_ME
# CLOUDFLARE_ACCOUNT_ID=REPLACE_ME

# Optional Kyra current-data provider examples
# FORGEREMS_WEATHER_PROVIDER=openmeteo
# FORGEREMS_WEATHER_DEFAULT_LOCATION=REPLACE_ME
# FORGEREMS_WEATHER_API_KEY=REPLACE_ME
# FORGEREMS_NEWS_PROVIDER=
# FORGEREMS_NEWS_API_KEY=REPLACE_ME
# FORGEREMS_FINANCE_PROVIDER=finnhub
# FORGEREMS_FINANCE_PROVIDER=alphavantage
# FORGEREMS_FINANCE_PROVIDER=fmp
# FORGEREMS_FINANCE_API_KEY=REPLACE_ME
# FORGEREMS_CRYPTO_PROVIDER=coingecko
# FORGEREMS_CRYPTO_API_KEY=REPLACE_ME
# FORGEREMS_STATS_PROVIDER=
# FORGEREMS_STATS_API_KEY=REPLACE_ME

# Marketplace / valuation future placeholders
# FORGEREMS_MARKETPLACE_ENABLED=false
# FORGEREMS_EBAY_ENABLED=false
# FORGEREMS_EBAY_APP_ID=REPLACE_ME
# FORGEREMS_EBAY_CERT_ID=REPLACE_ME
# FORGEREMS_EBAY_DEV_ID=REPLACE_ME
# FORGEREMS_MARKETPLACE_REGION=US
# FORGEREMS_VALUATION_MODE=offline

# Diagnostics and local preview
# FORGEREMS_DIAGNOSTICS_EXPORT_DIR=C:\Path\To\Local\Exports
# FORGEREMS_ENABLE_DIAGNOSTIC_BUNDLE=true
# FORGEREMS_LICENSE_TIER=PublicPreview
